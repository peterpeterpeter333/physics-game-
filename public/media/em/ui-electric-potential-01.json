  "scenes": [
    {
      "index": 0,
      "heading": "復習：電位は場所の値、電圧は2点の差",
      "narration": "電位とは、電荷一クーロンあたりの、電気的な位置エネルギーです。始点の電位が一ボルト、終点の電位が四ボルトなら、電位差は四引く一で三ボルトです。",
      "equations": [
        "V_B-V_A=4-1=3\\,\\mathrm V",
        "V_A-V_B=1-4=-3\\,\\mathrm V"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.416666666666667,
          "text": "電位とは、電荷一クーロンあたりの、電気的な位置エネルギーです。"
        },
        {
          "start": 4.416666666666667,
          "end": 10.583333333333332,
          "text": "始点の電位が一ボルト、終点の電位が四ボルトなら、電位差は四引く一で三ボルトです。"
        }
      ],
      "end": 10.72333333333333
    },
    {
      "index": 1,
      "heading": "復習：電場が仕事をすると位置エネルギーが減る",
      "narration": "電気力がプラスの仕事をすると、電気的な位置エネルギーは減ります。たとえば、電気力の仕事が三ジュールなら、位置エネルギーの変化はマイナス三ジュールです。仕事と位置エネルギーの変化は、符号が逆になります。",
      "equations": [
        "\\Delta U=-W_{\\rm 電場}",
        "\\Delta V=-\\frac{W_{\\rm 電場}}q"
      ],
      "spatial": false,
      "start": 10.72333333333333,
      "captions": [
        {
          "start": 10.72333333333333,
          "end": 15.291666666666664,
          "text": "電気力がプラスの仕事をすると、電気的な位置エネルギーは減ります。"
        },
        {
          "start": 15.291666666666664,
          "end": 21.041666666666664,
          "text": "たとえば、電気力の仕事が三ジュールなら、位置エネルギーの変化はマイナス三ジュールです。"
        },
        {
          "start": 21.041666666666664,
          "end": 24.958333333333332,
          "text": "仕事と位置エネルギーの変化は、符号が逆になります。"
        }
      ],
      "end": 25.088999999999995
    },
    {
      "index": 2,
      "heading": "復習：同じ電圧差でも距離が短いほど電場が強い",
      "narration": "一様な電場の強さは、「電位の下がり幅割る、電場方向の距離」です。同じ電位差でも、距離が短いほど電位の傾きは急になります。",
      "equations": [
        "\\Delta V=-\\frac{qEd}{q}=-Ed",
        "E=-\\frac{\\Delta V}{d}"
      ],
      "spatial": false,
      "start": 25.088999999999995,
      "captions": [
        {
          "start": 25.088999999999995,
          "end": 30.416666666666664,
          "text": "一様な電場の強さは、「電位の下がり幅割る、電場方向の距離」です。"
        },
        {
          "start": 30.416666666666664,
          "end": 35.02666666666666,
          "text": "同じ電位差でも、距離が短いほど電位の傾きは急になります。"
        }
      ],
      "end": 36.37666666666666
    }
