  "scenes": [
    {
      "index": 10,
      "heading": "電場の式に直すには、何を入れればよいだろう?",
      "narration": "電気力は「電荷かける電場」なので、力の線積分は、電場の式に書き換えられます。電荷が一定なら、その電荷は積分の外に出せます。",
      "equations": [
        "W=q\\int_C\\vec E\\cdot d\\vec r",
        "W=\\int_C q\\vec E\\cdot d\\vec r=q\\int_C\\vec E\\cdot d\\vec r"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 6.5,
          "text": "電気力は「電荷かける電場」なので、力の線積分は、電場の式に書き換えられます。"
        },
        {
          "start": 6.5,
          "end": 10.375,
          "text": "電荷が一定なら、その電荷は積分の外に出せます。"
        }
      ],
      "end": 10.456666666666663
    },
    {
      "index": 11,
      "heading": "記号の下に付いた C は、何を指しているのだろう?",
      "narration": "積分記号の下のシーは、電荷が進む曲線を指定します。その曲線には、始点と終点だけでなく、途中の道と進む向きも含まれます。",
      "equations": [],
      "spatial": false,
      "start": 10.456666666666663,
      "captions": [
        {
          "start": 10.456666666666663,
          "end": 14.625,
          "text": "積分記号の下のシーは、電荷が進む曲線を指定します。"
        },
        {
          "start": 14.625,
          "end": 20.166666666666668,
          "text": "その曲線には、始点と終点だけでなく、途中の道と進む向きも含まれます。"
        }
      ],
      "end": 20.294666666666664
    },
    {
      "index": 12,
      "heading": "道を逆向きにたどると、値はどうなるのだろう?",
      "narration": "同じ道を逆向きにたどると、各区間の移動ベクトルが反対になります。同じ力の分布での線積分は、大きさが同じで、符号が逆になります。",
      "equations": [],
      "spatial": false,
      "start": 20.294666666666664,
      "captions": [
        {
          "start": 20.294666666666664,
          "end": 25.25,
          "text": "同じ道を逆向きにたどると、各区間の移動ベクトルが反対になります。"
        },
        {
          "start": 25.25,
          "end": 30.708333333333336,
          "text": "同じ力の分布での線積分は、大きさが同じで、符号が逆になります。"
        }
      ],
      "end": 30.83566666666667
    },
    {
      "index": 13,
      "heading": "この値は、道を変えても同じなのだろうか?",
      "narration": "一般の力では、始点と終点が同じでも、仕事が道によって変わることがあります。一方、静電場の電気力の仕事は、道によらず、始点と終点だけで決まります。次は、この静電場の性質から、電位差を考えます。",
      "equations": [],
      "spatial": false,
      "start": 30.83566666666667,
      "captions": [
        {
          "start": 30.83566666666667,
          "end": 36.66666666666667,
          "text": "一般の力では、始点と終点が同じでも、仕事が道によって変わることがあります。"
        },
        {
          "start": 36.66666666666667,
          "end": 42.45833333333334,
          "text": "一方、静電場の電気力の仕事は、道によらず、始点と終点だけで決まります。"
        },
        {
          "start": 42.45833333333334,
          "end": 46.71966666666667,
          "text": "次は、この静電場の性質から、電位差を考えます。"
        }
      ],
      "end": 48.06966666666667
    }
  ],
