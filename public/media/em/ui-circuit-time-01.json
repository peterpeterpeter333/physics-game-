  "scenes": [
    {
      "index": 0,
      "heading": "復習：電池の電圧は抵抗とコンデンサに分かれる",
      "narration": "直列につないだ抵抗とコンデンサでは、各部品の両端の電圧を足すと電池電圧になります。抵抗の両端の電圧は電流に比例し、コンデンサの両端の電圧は蓄えた電荷に比例します。",
      "equations": [
        "V_0=V_R+V_C",
        "V_0=RI+\\frac qC"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 6.434,
          "text": "直列につないだ抵抗とコンデンサでは、各部品の両端の電圧を足すと電池電圧になります。"
        },
        {
          "start": 6.584,
          "end": 13.338,
          "text": "抵抗の両端の電圧は電流に比例し、コンデンサの両端の電圧は蓄えた電荷に比例します。"
        }
      ],
      "end": 14.687999999999999
    },
    {
      "index": 1,
      "heading": "橋渡し：電流Iは電荷qのグラフの傾き",
      "narration": "充電電流は、コンデンサの電荷が一秒あたりどれだけ増えるかを表します。電荷のグラフの傾きが、この増える速さです。電荷が増え続けていても、傾きが小さくなれば電流は小さくなります。",
      "equations": [
        "\\bar I=\\frac{\\Delta q}{\\Delta t}",
        "I=\\frac{dq}{dt}"
      ],
      "spatial": false,
      "start": 14.687999999999999,
      "captions": [
        {
          "start": 14.687999999999999,
          "end": 19.927333333333333,
          "text": "充電電流は、コンデンサの電荷が一秒あたりどれだけ増えるかを表します。"
        },
        {
          "start": 20.077333333333332,
          "end": 23.706,
          "text": "電荷のグラフの傾きが、この増える速さです。"
        },
        {
          "start": 23.855999999999998,
          "end": 29.105999999999998,
          "text": "電荷が増え続けていても、傾きが小さくなれば電流は小さくなります。"
        }
      ],
      "end": 30.455999999999996
    },
    {
      "index": 2,
      "heading": "復習：コイルは電流の変化に応じる",
      "narration": "コイルは、電流の変化を妨げる向きに起電力を生じます。理想コイルでは、電流が一定になると両端の電圧はゼロです。抵抗では、電流が一定でも両端に電圧が必要なので、両者は違います。",
      "equations": [
        "V_L=L\\frac{dI}{dt}",
        "\\frac{dI}{dt}=0\\quad\\Rightarrow\\quad V_L=0"
      ],
      "spatial": false,
      "start": 30.455999999999996,
      "captions": [
        {
          "start": 30.455999999999996,
          "end": 34.99133333333333,
          "text": "コイルは、電流の変化を妨げる向きに起電力を生じます。"
        },
        {
          "start": 35.14133333333333,
          "end": 39.858,
          "text": "理想コイルでは、電流が一定になると両端の電圧はゼロです。"
        },
        {
          "start": 40.007999999999996,
          "end": 45.833999999999996,
          "text": "抵抗では、電流が一定でも両端に電圧が必要なので、両者は違います。"
        }
      ],
      "end": 47.184
    }
