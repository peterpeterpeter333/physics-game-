  "scenes": [
    {
      "index": 8,
      "heading": "この足し算は、道の足し算と同じ形だろうか?",
      "narration": "線積分では、道を分けて、各区間の仕事を足しました。磁束の面積分では、面を分けて、各区画の磁束を足します。どちらも、小さな部分の計算から全体の値を求める方法です。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.416666666666667,
          "text": "線積分では、道を分けて、各区間の仕事を足しました。"
        },
        {
          "start": 4.416666666666667,
          "end": 9.166666666666666,
          "text": "磁束の面積分では、面を分けて、各区画の磁束を足します。"
        },
        {
          "start": 9.166666666666666,
          "end": 13.958333333333332,
          "text": "どちらも、小さな部分の計算から全体の値を求める方法です。"
        }
      ],
      "end": 14.075666666666667
    },
    {
      "index": 9,
      "heading": "面の向きを裏返すと、何が反転するのだろう?",
      "narration": "法線を反対向きに決め直すというのは、磁束をプラスと呼ぶ向きを反対にする、ということです。この操作では、磁場も面も動かしません。同じ磁場と面でも、磁束の符号だけが逆になります。",
      "equations": [],
      "spatial": false,
      "start": 14.075666666666667,
      "captions": [
        {
          "start": 14.075666666666667,
          "end": 20.291666666666668,
          "text": "法線を反対向きに決め直すというのは、磁束をプラスと呼ぶ向きを反対にする、ということです。"
        },
        {
          "start": 20.291666666666668,
          "end": 23.25,
          "text": "この操作では、磁場も面も動かしません。"
        },
        {
          "start": 23.25,
          "end": 27.208333333333332,
          "text": "同じ磁場と面でも、磁束の符号だけが逆になります。"
        }
      ],
      "end": 27.32133333333334
    },
    {
      "index": 10,
      "heading": "裏返した面の磁束は、いくらになるのだろう?",
      "narration": "法線が逆向きになると、各面のプラスマイナス付きの磁束も反転します。全体の磁束は、二点五ウェーバからマイナス二点五ウェーバに変わります。",
      "equations": [
        "\\Phi=-2.5\\,\\mathrm{Wb}"
      ],
      "spatial": false,
      "start": 27.32133333333334,
      "captions": [
        {
          "start": 27.32133333333334,
          "end": 32.33333333333333,
          "text": "法線が逆向きになると、各面のプラスマイナス付きの磁束も反転します。"
        },
        {
          "start": 32.33333333333333,
          "end": 37.125,
          "text": "全体の磁束は、二点五ウェーバからマイナス二点五ウェーバに変わります。"
        }
      ],
      "end": 37.233000000000004
    },
    {
      "index": 11,
      "heading": "タイルを16枚に増やしても、やることは同じだろうか?",
      "narration": "小さな区画では、磁場と面の傾きをほぼ一定とみなして、法線方向の分と面積を掛けます。面全体の磁束の近似値は、各区画の磁束を、マイナスも含めて足したものです。分け方を細かくし続けたときの行き着く先が、面積分です。",
      "equations": [],
      "spatial": false,
      "start": 37.233000000000004,
      "captions": [
        {
          "start": 37.233000000000004,
          "end": 43.75,
          "text": "小さな区画では、磁場と面の傾きをほぼ一定とみなして、法線方向の分と面積を掛けます。"
        },
        {
          "start": 43.75,
          "end": 49.54166666666667,
          "text": "面全体の磁束の近似値は、各区画の磁束を、マイナスも含めて足したものです。"
        },
        {
          "start": 49.54166666666667,
          "end": 54.056666666666686,
          "text": "分け方を細かくし続けたときの行き着く先が、面積分です。"
        }
      ],
      "end": 55.40666666666668
    }
