  "scenes": [
    {
      "index": 6,
      "heading": "角度を変えると、磁束はどう動くのだろう?",
      "narration": "磁場と法線の角度がゼロ度から九十度へ増えると、法線方向の分は減っていきます。この例の磁束は、一ウェーバからゼロまで減ります。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.541666666666667,
          "text": "磁場と法線の角度がゼロ度から九十度へ増えると、法線方向の分は減っていきます。"
        },
        {
          "start": 5.541666666666667,
          "end": 9.166666666666668,
          "text": "この例の磁束は、一ウェーバからゼロまで減ります。"
        }
      ],
      "end": 9.293999999999997
    },
    {
      "index": 7,
      "heading": "「本数」という言い方は、どこまで正しいのだろう?",
      "narration": "図に描く磁力線の本数を増やしても、本当の磁場や磁束は変わりません。磁力線は磁場を見やすくするための線です。磁束は線を数えて出すものではなく、「面に垂直な磁場の分かける面積」で計算します。",
      "equations": [],
      "spatial": false,
      "start": 9.293999999999997,
      "captions": [
        {
          "start": 9.293999999999997,
          "end": 14.375,
          "text": "図に描く磁力線の本数を増やしても、本当の磁場や磁束は変わりません。"
        },
        {
          "start": 14.375,
          "end": 17.208333333333332,
          "text": "磁力線は磁場を見やすくするための線です。"
        },
        {
          "start": 17.208333333333332,
          "end": 23.958333333333332,
          "text": "磁束は線を数えて出すものではなく、「面に垂直な磁場の分かける面積」で計算します。"
        }
      ],
      "end": 24.11533333333333
    },
    {
      "index": 8,
      "heading": "1枚の面の磁束は、どう書けばよいのだろう?",
      "narration": "一様な磁場での平面の磁束は、「法線方向の磁場の分かける面積」です。面に沿う磁場の分は、この掛け算には入れません。面に平行な磁場だけなら、磁束はゼロです。",
      "equations": [
        "\\Phi=B_{\\perp}A"
      ],
      "spatial": false,
      "start": 24.11533333333333,
      "captions": [
        {
          "start": 24.11533333333333,
          "end": 29.916666666666664,
          "text": "一様な磁場での平面の磁束は、「法線方向の磁場の分かける面積」です。"
        },
        {
          "start": 29.916666666666664,
          "end": 33.24999999999999,
          "text": "面に沿う磁場の分は、この掛け算には入れません。"
        },
        {
          "start": 33.24999999999999,
          "end": 36.735333333333315,
          "text": "面に平行な磁場だけなら、磁束はゼロです。"
        }
      ],
      "end": 38.08533333333332
    }
  ],
