  "scenes": [
    {
      "index": 0,
      "heading": "充電前の状態を指定する",
      "narration": "この回路では、電荷ゼロのコンデンサに、抵抗を通して一定の電圧の電池をつなぎます。充電途中のコンデンサの電圧は、「その時点の電荷割る電気容量」です。この電圧は、最初から電池の電圧と同じではありません。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.958333333333333,
          "text": "この回路では、電荷ゼロのコンデンサに、抵抗を通して一定の電圧の電池をつなぎます。"
        },
        {
          "start": 5.958333333333333,
          "end": 10.958333333333332,
          "text": "充電途中のコンデンサの電圧は、「その時点の電荷割る電気容量」です。"
        },
        {
          "start": 10.958333333333332,
          "end": 15.083333333333336,
          "text": "この電圧は、最初から電池の電圧と同じではありません。"
        }
      ],
      "end": 15.217000000000002
    },
    {
      "index": 1,
      "heading": "コンデンサの充電は、なぜあの曲線なのだろう?",
      "narration": "電池の電圧は、抵抗の電圧とコンデンサの電圧の和です。電流を「電荷の時間微分」に置き換えると、電荷の変化を求める微分方程式になります。",
      "equations": [
        "q(t) = CV_0\\left(1 - e^{-t/RC}\\right)",
        "\\frac{u'}u=-\\frac1{RC}",
        "\\ln|u|=-\\frac t{RC}+K",
        "u=CV_0e^{-t/(RC)}",
        "q=CV_0-u=CV_0(1-e^{-t/(RC)})",
        "I=q'=CV_0\\frac1{RC}e^{-t/(RC)}=\\frac{V_0}{R}e^{-t/(RC)}"
      ],
      "spatial": false,
      "start": 15.217000000000002,
      "captions": [
        {
          "start": 15.217000000000002,
          "end": 19.333333333333336,
          "text": "電池の電圧は、抵抗の電圧とコンデンサの電圧の和です。"
        },
        {
          "start": 19.333333333333336,
          "end": 25.875000000000004,
          "text": "電流を「電荷の時間微分」に置き換えると、電荷の変化を求める微分方程式になります。"
        }
      ],
      "end": 26.002333333333333
    },
    {
      "index": 2,
      "heading": "充電完了までの差を変数にする",
      "narration": "充電が終わったときの電荷から今の電荷を引いた、残りの差をユーとします。この差が大きいほど充電電流は大きく、差は速く減ります。差が小さくなると減り方もゆっくりになり、ユーは指数関数の形でゼロに近づきます。",
      "equations": [
        "V_0=Rq'+\\frac qC",
        "Rq'=\\frac{CV_0-q}{C}",
        "q'=\\frac{u}{RC}",
        "u'=-\\frac{u}{RC}"
      ],
      "spatial": false,
      "start": 26.002333333333333,
      "captions": [
        {
          "start": 26.002333333333333,
          "end": 30.750000000000007,
          "text": "充電が終わったときの電荷から今の電荷を引いた、残りの差をユーとします。"
        },
        {
          "start": 30.750000000000007,
          "end": 34.75000000000001,
          "text": "この差が大きいほど充電電流は大きく、差は速く減ります。"
        },
        {
          "start": 34.75000000000001,
          "end": 40.779,
          "text": "差が小さくなると減り方もゆっくりになり、ユーは指数関数の形でゼロに近づきます。"
        }
      ],
      "end": 42.129000000000005
    }
  ],
