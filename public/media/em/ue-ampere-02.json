  "scenes": [
    {
      "index": 3,
      "heading": "ソレノイドの中は、なぜ一様な磁場なのだろう?",
      "narration": "十分長いソレノイドの中央付近では、内部の磁場はほぼ一定で、外の磁場は小さくなります。内部と外部を通る長方形の道を選び、アンペールの法則を使います。どの辺で磁場と移動方向が重なるかを、次に調べます。",
      "equations": [
        "B = \\mu_0 n I",
        "\\oint\\vec B\\cdot d\\vec r=BL+0+0+0",
        "BL=\\mu_0(nL)I",
        "B=\\mu_0nI",
        "B=\\mu_0\\frac Nl I"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 6.775333333333333,
          "text": "十分長いソレノイドの中央付近では、内部の磁場はほぼ一定で、外の磁場は小さくなります。"
        },
        {
          "start": 6.925333333333333,
          "end": 12.154,
          "text": "内部と外部を通る長方形の道を選び、アンペールの法則を使います。"
        },
        {
          "start": 12.303999999999998,
          "end": 16.668666666666663,
          "text": "どの辺で磁場と移動方向が重なるかを、次に調べます。"
        }
      ],
      "end": 18.018666666666665
    },
    {
      "index": 4,
      "heading": "ソレノイドの長方形の4辺を数える",
      "narration": "この近似では、長方形のうち、コイル内部の辺だけが周回積分に残ります。長方形が囲む面を、巻数密度かける辺の長さの本数だけ導線が横切ります。この本数に一巻きの電流を掛けると、面を貫く電流の合計です。",
      "equations": [
        "\\oint\\vec B\\cdot d\\vec r=BL+0+0+0",
        "BL=\\mu_0(nL)I",
        "B=\\mu_0nI",
        "B=\\mu_0\\frac Nl I"
      ],
      "spatial": false,
      "start": 18.018666666666665,
      "captions": [
        {
          "start": 18.018666666666665,
          "end": 23.961999999999996,
          "text": "この近似では、長方形のうち、コイル内部の辺だけが周回積分に残ります。"
        },
        {
          "start": 24.112,
          "end": 30.236666666666665,
          "text": "長方形が囲む面を、巻数密度かける辺の長さの本数だけ導線が横切ります。"
        },
        {
          "start": 30.386666666666663,
          "end": 35.594,
          "text": "この本数に一巻きの電流を掛けると、面を貫く電流の合計です。"
        }
      ],
      "end": 36.944
    },
    {
      "index": 5,
      "heading": "長さLが消えて巻数密度だけ残る",
      "narration": "アンペールの法則の両辺には、長方形の辺の長さが現れるので、約分できます。残る式は、透磁率と、一メートルあたりの巻数と、電流の積です。短いコイルや端の近くでは磁場が一様でなくなり、この近似式からずれます。",
      "equations": [
        "B=\\mu_0\\frac{N}{l}I",
        "\\oint\\vec B\\cdot d\\vec r=BL+0+0+0",
        "BL=\\mu_0(nL)I",
        "B=\\mu_0nI",
        "B=\\mu_0\\frac Nl I"
      ],
      "spatial": false,
      "start": 36.944,
      "captions": [
        {
          "start": 36.944,
          "end": 43.29266666666667,
          "text": "アンペールの法則の両辺には、長方形の辺の長さが現れるので、約分できます。"
        },
        {
          "start": 43.44266666666667,
          "end": 49.034000000000006,
          "text": "残る式は、透磁率と、一メートルあたりの巻数と、電流の積です。"
        },
        {
          "start": 49.184,
          "end": 54.722,
          "text": "短いコイルや端の近くでは磁場が一様でなくなり、この近似式からずれます。"
