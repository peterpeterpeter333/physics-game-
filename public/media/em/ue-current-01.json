  "scenes": [
    {
      "index": 0,
      "heading": "オームの法則は、なぜ「比例」なのだろう?",
      "narration": "金属中の電子は、電場で加速される一方、原子の振動や不純物などによって進む向きを乱されます。そのため、電子全体の平均速度は増え続けません。このモデルの定常状態では、電流密度は電場に比例します。",
      "equations": [
        "\\vec{j} = \\sigma\\vec{E}"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 7.4046666666666665,
          "text": "金属中の電子は、電場で加速される一方、原子の振動や不純物などによって進む向きを乱されます。"
        },
        {
          "start": 7.554666666666666,
          "end": 11.716666666666665,
          "text": "そのため、電子全体の平均速度は増え続けません。"
        },
        {
          "start": 11.866666666666667,
          "end": 16.593999999999998,
          "text": "このモデルの定常状態では、電流密度は電場に比例します。"
        }
      ],
      "end": 17.944
    },
    {
      "index": 1,
      "heading": "衝突モデルからドリフト速度へ",
      "narration": "この運動方程式は、電子の平均速度がどう変化するかを表します。式には、電場による力と、散乱によって平均の運動が弱まる効果が入ります。定常状態の平均速度は、電子の負の電荷のため電場と逆向きです。",
      "equations": [
        "m\\dot{\\vec v}=-e\\vec E-\\frac m\\tau\\vec v",
        "0=-e\\vec E-\\frac m\\tau\\vec v",
        "\\frac m\\tau\\vec v=-e\\vec E",
        "\\vec v=-\\frac{e\\tau}{m}\\vec E"
      ],
      "spatial": false,
      "start": 17.944,
      "captions": [
        {
          "start": 17.944,
          "end": 23.140666666666664,
          "text": "この運動方程式は、電子の平均速度がどう変化するかを表します。"
        },
        {
          "start": 23.290666666666667,
          "end": 29.287333333333333,
          "text": "式には、電場による力と、散乱によって平均の運動が弱まる効果が入ります。"
        },
        {
          "start": 29.437333333333335,
          "end": 34.858000000000004,
          "text": "定常状態の平均速度は、電子の負の電荷のため電場と逆向きです。"
        }
      ],
      "end": 36.208000000000006
    },
    {
      "index": 2,
      "heading": "電子の流れを電流密度に変える",
      "narration": "電流密度は、粒子の数密度と電荷と平均速度の積です。電子の速度の式を代入した結果では負号が相殺し、電流密度は電場と同じ向きになります。",
      "equations": [
        "\\vec j=\\frac{ne^2\\tau}{m}\\vec E=\\sigma\\vec E",
        "\\vec j=-ne\\vec v",
        "\\vec j=-ne\\left(-\\frac{e\\tau}{m}\\vec E\\right)",
        "\\vec j=\\frac{ne^2\\tau}{m}\\vec E",
        "\\sigma=\\frac{ne^2\\tau}{m},\\quad\\vec j=\\sigma\\vec E"
      ],
      "spatial": false,
      "start": 36.208000000000006,
      "captions": [
        {
          "start": 36.208000000000006,
          "end": 40.988666666666674,
          "text": "電流密度は、粒子の数密度と電荷と平均速度の積です。"
        },
        {
          "start": 41.13866666666667,
          "end": 47.732666666666674,
          "text": "電子の速度の式を代入した結果では負号が相殺し、電流密度は電場と同じ向きになります。"
        }
      ],
      "end": 49.082666666666675
    },
    {
      "index": 3,
      "heading": "局所の式からV=RIへ",
      "narration": "一様な導線では、電流密度に断面積を掛けると電流になります。導線内の電場は、両端の電圧をその間の長さで割った値です。この二つを使うと、抵抗は抵抗率と長さの積を断面積で割った値になります。",
      "equations": [
        "R=\\rho\\frac{l}{S}",
        "I=jS",
        "I=\\sigma\\frac Vl S",
        "V=\\frac l{\\sigma S}I",
        "R=\\frac l{\\sigma S}",
        "R=\\rho\\frac lS"
      ],
      "spatial": false,
      "start": 49.082666666666675,
      "captions": [
        {
          "start": 49.082666666666675,
          "end": 54.21533333333335,
          "text": "一様な導線では、電流密度に断面積を掛けると電流になります。"
        },
        {
          "start": 54.36533333333334,
          "end": 59.24200000000001,
          "text": "導線内の電場は、両端の電圧をその間の長さで割った値です。"
        },
        {
          "start": 59.392,
          "end": 65.186,
          "text": "この二つを使うと、抵抗は抵抗率と長さの積を断面積で割った値になります。"
        }
      ],
      "end": 66.536
    }
