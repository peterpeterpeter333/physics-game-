  "scenes": [
    {
      "index": 3,
      "heading": "面を磁場と平行にすると、通り抜ける量はどうなるのだろう?",
      "narration": "磁場が面と平行なら、面に垂直な磁場の分はゼロです。面積が同じでも、その面の磁束はゼロになります。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.041666666666667,
          "text": "磁場が面と平行なら、面に垂直な磁場の分はゼロです。"
        },
        {
          "start": 4.041666666666667,
          "end": 7.875000000000001,
          "text": "面積が同じでも、その面の磁束はゼロになります。"
        }
      ],
      "end": 8.014
    },
    {
      "index": 4,
      "heading": "斜めのとき、減っているのは何なのだろう?",
      "narration": "磁場の矢印の向きから面をのぞくと、面を傾けるほど、見かけの広さが小さくなります。この見かけの広さを、投影面積と呼びます。ここでは磁場の強さと元の面積は変えていません。",
      "equations": [],
      "spatial": false,
      "start": 8.014,
      "captions": [
        {
          "start": 8.014,
          "end": 14.208333333333336,
          "text": "磁場の矢印の向きから面をのぞくと、面を傾けるほど、見かけの広さが小さくなります。"
        },
        {
          "start": 14.208333333333336,
          "end": 17.41666666666667,
          "text": "この見かけの広さを、投影面積と呼びます。"
        },
        {
          "start": 17.41666666666667,
          "end": 20.91666666666667,
          "text": "ここでは磁場の強さと元の面積は変えていません。"
        }
      ],
      "end": 21.057000000000002
    },
    {
      "index": 5,
      "heading": "45°に傾けると、磁束はどうなるのだろう?",
      "narration": "磁場と法線の角度が四十五度なら、投影面積は元の面積の約〇点七一倍です。だからこの例の磁束は、約〇点七一ウェーバです。",
      "equations": [
        "\\Phi=BA\\cos 45^\\circ\\approx0.71\\,\\mathrm{Wb}",
        "A_{\\perp}=0.5\\cos 45^\\circ\\approx0.35\\,\\mathrm{m^2}",
        "\\Phi=2\\times0.35\\approx0.71\\,\\mathrm{Wb}"
      ],
      "spatial": false,
      "start": 21.057000000000002,
      "captions": [
        {
          "start": 21.057000000000002,
          "end": 27.208333333333336,
          "text": "磁場と法線の角度が四十五度なら、投影面積は元の面積の約〇点七一倍です。"
        },
        {
          "start": 27.208333333333336,
          "end": 31.15466666666667,
          "text": "だからこの例の磁束は、約〇点七一ウェーバです。"
        }
      ],
      "end": 32.50466666666667
