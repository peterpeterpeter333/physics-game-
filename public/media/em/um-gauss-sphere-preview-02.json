      "spatial": false,
      "start": 20.85333333333333,
      "captions": [
        {
          "start": 20.85333333333333,
          "end": 25.68733333333333,
          "text": "各区画に共通する電場の強さは、面積分の外へ出せます。"
        },
        {
          "start": 25.837333333333333,
          "end": 30.340666666666667,
          "text": "残った積分は、球の各区画の面積だけの集計です。"
        }
