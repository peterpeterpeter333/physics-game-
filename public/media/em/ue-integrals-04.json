            "電場と法線のなす角"
          ],
          [
            "β",
            "電場の増え方 [V/m²]"
          ],
          [
            "L",
            "正方形の一辺 [m]"
          ],
          [
            "dx dy",
            "縦横の小幅を掛けた面積"
          ]
        ],
        "steps": [
          {
            "note": "平面の小面積はdx dy。xもyも0からLまで動かす。",
            "tex": "\\Phi_E=\\int_0^L\\left(\\int_0^L\\beta x\\,dx\\right)dy"
          },
          {
            "note": "βは定数。xの原始関数x²/2を使い、両端の差を取る。",
