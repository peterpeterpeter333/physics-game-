      "guide": {
        "kind": "内側の積分",
        "read": "まず横方向の一列を足す。まだ面全体の電気束ではない。",
        "symbols": [
          [
            "ΦE",
            "電気束 [N·m²/C]。仕事ではない"
          ],
          [
            "n",
            "面に垂直な長さ1のベクトル"
          ],
          [
            "dA",
            "小さな面積 [m²]"
