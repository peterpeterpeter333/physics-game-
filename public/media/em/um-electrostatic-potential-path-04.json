  "scenes": [
    {
      "index": 7,
      "heading": "位置エネルギーは、どれだけ変わるのだろう?",
      "narration": "電気的な位置エネルギーの変化は、電気力の仕事にマイナスを付けたものです。電気力がプラスの仕事をすると、位置エネルギーは減ります。",
      "equations": [
        "\\Delta U=-W_{\\mathrm{AB}}",
        "\\Delta U=U_{\\mathrm B}-U_{\\mathrm A}=-W_{\\mathrm{AB}}"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.125,
          "text": "電気的な位置エネルギーの変化は、電気力の仕事にマイナスを付けたものです。"
        },
        {
          "start": 5.125,
          "end": 9.333333333333332,
          "text": "電気力がプラスの仕事をすると、位置エネルギーは減ります。"
        }
      ],
      "end": 9.483999999999998
    },
    {
      "index": 8,
      "heading": "電荷によらない量に、どうすれば直せるだろう?",
      "narration": "電位差とは、位置エネルギーの変化を電荷で割ったものです。その単位ジュール毎クーロンは、ボルトと同じです。",
      "equations": [
        "\\Delta V=\\frac{\\Delta U}{q}"
      ],
      "spatial": false,
      "start": 9.483999999999998,
      "captions": [
        {
          "start": 9.483999999999998,
          "end": 13.291666666666668,
          "text": "電位差とは、位置エネルギーの変化を電荷で割ったものです。"
        },
        {
          "start": 13.291666666666668,
          "end": 16.791666666666664,
          "text": "その単位ジュール毎クーロンは、ボルトと同じです。"
        }
      ],
      "end": 16.952999999999996
    },
    {
      "index": 9,
      "heading": "電位差は、線積分でどう書けるのだろう?",
      "narration": "電位差の定義は、「位置エネルギーの変化割る電荷」です。位置エネルギーの変化を、「電気力の仕事のマイナス」に置き換えます。さらに仕事を線積分で書くと、電荷が分子と分母で消えて、電位差は「電場の線積分のマイナス」になります。",
      "equations": [
        "V_{\\mathrm B}-V_{\\mathrm A}=-\\int_{\\mathrm A}^{\\mathrm B}\\vec E\\cdot d\\vec r"
      ],
      "spatial": false,
      "start": 16.952999999999996,
      "captions": [
        {
          "start": 16.952999999999996,
          "end": 20.958333333333332,
          "text": "電位差の定義は、「位置エネルギーの変化割る電荷」です。"
        },
        {
          "start": 20.958333333333332,
          "end": 25.458333333333332,
          "text": "位置エネルギーの変化を、「電気力の仕事のマイナス」に置き換えます。"
        },
        {
          "start": 25.458333333333332,
          "end": 33.39266666666666,
          "text": "さらに仕事を線積分で書くと、電荷が分子と分母で消えて、電位差は「電場の線積分のマイナス」になります。"
        }
      ],
      "end": 34.742666666666665
    }
  ],
