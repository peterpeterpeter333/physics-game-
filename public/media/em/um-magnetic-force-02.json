  "scenes": [
    {
      "index": 2,
      "heading": "外積の方向を、電荷の符号まで確認",
      "narration": "右手の四本の指を、速度の矢印から磁場の矢印へ、小さい角度の側に曲げます。伸ばした親指の向きが、「速度と磁場の外積」の向きです。プラスの電荷の力はその向き、マイナスの電荷の力は逆向きです。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.958333333333333,
          "text": "右手の四本の指を、速度の矢印から磁場の矢印へ、小さい角度の側に曲げます。"
        },
        {
          "start": 5.958333333333333,
          "end": 10.25,
          "text": "伸ばした親指の向きが、「速度と磁場の外積」の向きです。"
        },
        {
          "start": 10.25,
          "end": 14.999999999999998,
          "text": "プラスの電荷の力はその向き、マイナスの電荷の力は逆向きです。"
        }
      ],
      "end": 15.135666666666664
    },
    {
      "index": 3,
      "heading": "なぜ荷電粒子は円を描くのだろう?",
      "narration": "一様な磁場に、初速度が垂直で電場がない場合、磁気力が円運動の向心力になります。半径は、「質量かける速さ、割る、電荷の大きさかける磁場」です。",
      "equations": [
        "r=\\frac{mv_\\perp}{|q|B}",
        "|q|v_\\perp B=\\frac{mv_\\perp^2}{r}",
        "|q|Br=mv_\\perp",
        "T=\\frac{2\\pi r}{v_\\perp}",
        "T=\\frac{2\\pi m\\cancel{v_\\perp}}{|q|B\\cancel{v_\\perp}}=\\frac{2\\pi m}{|q|B}"
      ],
      "spatial": false,
      "start": 15.135666666666664,
      "captions": [
        {
          "start": 15.135666666666664,
          "end": 21.5,
          "text": "一様な磁場に、初速度が垂直で電場がない場合、磁気力が円運動の向心力になります。"
        },
        {
          "start": 21.5,
          "end": 26.916666666666664,
          "text": "半径は、「質量かける速さ、割る、電荷の大きさかける磁場」です。"
        }
      ],
      "end": 27.064333333333323
    },
    {
      "index": 4,
      "heading": "仕事0だけでは円と決まらない",
      "narration": "磁気力だけが働く場合、磁気力の仕事はゼロなので、粒子の運動エネルギーと速さは変わりません。電気力などが同時に働く場合は、ほかの力の仕事で速さが変わることがあります。",
      "equations": [],
      "spatial": false,
      "start": 27.064333333333323,
      "captions": [
        {
          "start": 27.064333333333323,
          "end": 33.83333333333333,
          "text": "磁気力だけが働く場合、磁気力の仕事はゼロなので、粒子の運動エネルギーと速さは変わりません。"
        },
        {
          "start": 33.83333333333333,
