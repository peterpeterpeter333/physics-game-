  "scenes": [
    {
      "index": 0,
      "heading": "斜めに引かれた箱は、どちらへ動くのだろう?",
      "narration": "この例の箱は、床に沿って右へ二メートル動きます。箱を引く十ニュートンの力は、右向きから上へ六十度傾いています。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 3.7083333333333335,
          "text": "この例の箱は、床に沿って右へ二メートル動きます。"
        },
        {
          "start": 3.7083333333333335,
          "end": 8.5,
          "text": "箱を引く十ニュートンの力は、右向きから上へ六十度傾いています。"
        }
      ],
      "end": 8.600666666666665
    },
    {
      "index": 1,
      "heading": "10 N に 2 m を掛けて、20 J としてよいのだろうか?",
      "narration": "箱は右へだけ動きます。だから仕事の計算では、斜めの力のうち、箱を右へ引く分だけを使います。この右向きの分を、力の「右向き成分」と呼びます。",
      "equations": [],
      "spatial": false,
      "start": 8.600666666666665,
      "captions": [
        {
          "start": 8.600666666666665,
          "end": 10.625,
          "text": "箱は右へだけ動きます。"
        },
        {
          "start": 10.625,
          "end": 16.041666666666668,
          "text": "だから仕事の計算では、斜めの力のうち、箱を右へ引く分だけを使います。"
        },
        {
          "start": 16.041666666666668,
          "end": 20.583333333333336,
          "text": "この右向きの分を、力の「右向き成分」と呼びます。"
        }
      ],
      "end": 20.694333333333333
    },
    {
      "index": 2,
      "heading": "斜めの矢印を、2本に分けてみよう",
      "narration": "斜めの力は、右向きの成分と上向きの成分を足したものとして表せます。この分け方は、新しい力を付け足す操作ではありません。",
      "equations": [],
      "spatial": false,
      "start": 20.694333333333333,
      "captions": [
        {
          "start": 20.694333333333333,
          "end": 26.0,
          "text": "斜めの力は、右向きの成分と上向きの成分を足したものとして表せます。"
        },
        {
          "start": 26.0,
          "end": 30.259666666666668,
          "text": "この分け方は、新しい力を付け足す操作ではありません。"
        }
      ],
      "end": 31.60966666666667
    }
  ],
