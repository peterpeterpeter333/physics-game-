  "scenes": [
    {
      "narration": "電荷は、電気の力に関わる物体の性質で、プラスとマイナスがあります。電子はマイナスの電荷を持ち、電荷の量はクーロンで表します。",
      "equation": "同じ符号の電荷は反発；異なる符号は引き合う",
      "diagram": {
        "kind": "vectors",
        "vectors": [
          [
            -3,
            0,
            "正電荷が受ける力"
          ],
          [
            3,
            0,
            "もう一つの正電荷が受ける力"
          ]
        ]
      },
      "index": 0,
      "heading": "電荷は、電気の力に関わる物体の性質で、プラスとマイナスがあります。",
      "symbols": "",
