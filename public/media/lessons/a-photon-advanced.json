  "scenes": [
    {
      "index": 0,
      "heading": "原子の中の電子が持てるエネルギーは、連続ではなく、とびとびの値だけです。",
      "narration": "原子の中の電子が持てるエネルギーは、連続ではなく、とびとびの値だけです。電子が高いエネルギーから低いエネルギーへ移ると、その差のぶんの光子を出せます。",
      "visual": "空間の軌道ではなくエネルギー軸へ準位を描き、縦の差を強調。",
      "equation": "",
      "symbols": "",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.291666666666667,
          "text": "原子の中の電子が持てるエネルギーは、連続ではなく、とびとびの値だけです。"
        },
        {
          "start": 5.291666666666667,
          "end": 10.583333333333334,
          "text": "電子が高いエネルギーから低いエネルギーへ移ると、その差のぶんの光子を出せます。"
        }
      ],
      "end": 10.700999999999997
    },
    {
      "index": 1,
      "heading": "光子のエネルギーを振動数に直すと、エネルギーの段、準位の差ごとに、光の振動数が決まります。",
      "narration": "光子のエネルギーを振動数に直すと、エネルギーの段、準位の差ごとに、光の振動数が決まります。準位の図の高さは、電子が実際にいる高さではありません。",
      "visual": "準位差→hν→色の順に対応させる。",
      "equation": "hν = E高−E低",
      "symbols": "E高とE低は電子を含む原子のエネルギー準位、νは放出光の振動数、hはプランク定数。",
      "start": 10.700999999999997,
      "captions": [
        {
          "start": 10.700999999999997,
          "end": 17.541666666666668,
          "text": "光子のエネルギーを振動数に直すと、エネルギーの段、準位の差ごとに、光の振動数が決まります。"
        },
        {
          "start": 17.541666666666668,
          "end": 21.791666666666668,
          "text": "準位の図の高さは、電子が実際にいる高さではありません。"
