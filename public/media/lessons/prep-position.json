  "scenes": [
    {
      "narration": "道の上のどこにいるかは、基準の点から測ります。この図では、基準の点をゼロ、右向きをプラスと決めます。",
      "equation": "原点 = 位置の基準；右を正とする",
      "diagram": {
        "kind": "numberline",
        "from": 0,
        "to": 3,
        "t0": 0,
        "t1": 3
      },
      "index": 0,
      "heading": "道の上のどこにいるかは、基準の点から測ります。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 3.6666666666666665,
          "text": "道の上のどこにいるかは、基準の点から測ります。"
        },
        {
          "start": 3.6666666666666665,
          "end": 7.958333333333332,
          "text": "この図では、基準の点をゼロ、右向きをプラスと決めます。"
        }
      ],
      "end": 8.077999999999998
    },
    {
      "narration": "人が一メートルの位置から四メートルの位置へ移ると、位置の変化は四引く一で、三メートルです。位置の変化は、後の位置から前の位置を引いて求めます。",
      "equation": "位置の変化 = 4 − 1 = 3 m",
      "diagram": {
        "kind": "numberline",
        "from": 1,
        "to": 4,
        "t0": 0,
        "t1": 3
      },
      "index": 1,
      "heading": "人が一メートルの位置から四メートルの位置へ移ると、位置の変化は四引く一で、三メートルです。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 8.077999999999998,
      "captions": [
        {
          "start": 8.077999999999998,
          "end": 14.291666666666664,
          "text": "人が一メートルの位置から四メートルの位置へ移ると、位置の変化は四引く一で、三メートルです。"
        },
        {
          "start": 14.291666666666664,
          "end": 18.291666666666664,
          "text": "位置の変化は、後の位置から前の位置を引いて求めます。"
        }
      ],
      "end": 18.37366666666666
    },
    {
      "narration": "時計が二秒から五秒になると、たった時間は五引く二で、三秒です。平均速度は、位置の変化を、たった時間で割ったものです。",
      "equation": "平均速度 = 3 m ÷ 3 s = 1 m/s",
      "diagram": {
        "kind": "numberline",
        "from": 1,
        "to": 4,
        "t0": 2,
        "t1": 5
      },
      "index": 2,
      "heading": "時計が二秒から五秒になると、たった時間は五引く二で、三秒です。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 18.37366666666666,
      "captions": [
        {
          "start": 18.37366666666666,
          "end": 23.083333333333332,
          "text": "時計が二秒から五秒になると、たった時間は五引く二で、三秒です。"
        },
        {
          "start": 23.083333333333332,
          "end": 27.333333333333332,
          "text": "平均速度は、位置の変化を、たった時間で割ったものです。"
        }
      ],
      "end": 27.412666666666663
    },
    {
      "narration": "人が逆向きに戻ると、位置の変化はマイナスになります。歩いた道のりはいつもプラスの長さですが、位置の変化には向きがあります。",
      "equation": "位置の変化 = 1 − 4 = −3 m",
      "diagram": {
