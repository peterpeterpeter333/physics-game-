  "scenes": [
    {
      "narration": "角度はラジアンで測ります。半径一の円の小さなプラスの角度では、内側の三角形、扇形、外側の三角形の面積を比べられます。",
      "equation": "0<h<π/2：sin h < h < tan h",
      "diagram": {
        "kind": "bars",
        "labels": [
          "sin h",
          "h",
          "tan h"
        ],
        "values": [
          0.5646424733950354,
          0.6,
          0.6841368083416923
        ],
        "unit": "h=0.6の場合"
      },
      "index": 0,
      "heading": "角度はラジアンで測ります。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 2.0833333333333335,
          "text": "角度はラジアンで測ります。"
        },
        {
          "start": 2.0833333333333335,
          "end": 9.958333333333332,
          "text": "半径一の円の小さなプラスの角度では、内側の三角形、扇形、外側の三角形の面積を比べられます。"
        }
      ],
      "end": 10.072666666666667
    },
    {
      "narration": "不等式を並べ直すと、「サインエイチ割るエイチ」は、コサインエイチと一の間にあります。両側が一に近づくので、挟まれた値も一に近づきます。",
      "equation": "cos h < sin h/h < 1 → sin h/h → 1",
      "diagram": {
        "kind": "plot",
        "xLabel": "幅 h",
        "yLabel": "sin h/h",
        "points": [
          [
            0,
            1
