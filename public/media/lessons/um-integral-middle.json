  "scenes": [
    {
      "index": 0,
      "heading": "幅一の区間で、関数の値が入力そのものに等しい例を考えます。",
      "narration": "幅一の区間で、関数の値が入力そのものに等しい例を考えます。区間を等分して、各区間の右端の値と幅を掛けて足します。",
      "visual": "0〜1をN等分し、右端i/Nと幅1/Nを別表示。",
      "equation": "S_N = Σ[i=1…N] (i/N)(1/N)",
      "symbols": "Nは区間数、iは区間番号、S_Nは長方形の面積の和。",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.916666666666667,
          "text": "幅一の区間で、関数の値が入力そのものに等しい例を考えます。"
        },
        {
          "start": 4.916666666666667,
          "end": 9.541666666666666,
          "text": "区間を等分して、各区間の右端の値と幅を掛けて足します。"
        }
      ],
      "end": 9.677999999999997
    },
    {
      "index": 1,
      "heading": "一から整数までの和の公式を使うと、面積の合計は二分の一に近づく形になります。",
      "narration": "一から整数までの和の公式を使うと、面積の合計は二分の一に近づく形になります。区間の数を増やすほど、右端を使ったぶんの余分な面積は小さくなります。",
      "visual": "Σi=N(N+1)/2を代入し、1/2+1/(2N)へ整理。",
      "equation": "S_N = (N+1)/(2N) → 1/2",
      "symbols": "矢印はNを限りなく大きくした極限。",
      "start": 9.677999999999997,
      "captions": [
        {
          "start": 9.677999999999997,
          "end": 15.875,
          "text": "一から整数までの和の公式を使うと、面積の合計は二分の一に近づく形になります。"
        },
        {
          "start": 15.875,
          "end": 21.166666666666668,
          "text": "区間の数を増やすほど、右端を使ったぶんの余分な面積は小さくなります。"
        }
      ],
      "end": 21.255666666666666
    },
    {
      "index": 2,
      "heading": "この行き着く先の値を、ゼロから一までの定積分と書きます。",
      "narration": "この行き着く先の値を、ゼロから一までの定積分と書きます。積分記号の上と下の数は、どの範囲を足したかを表しています。",
      "visual": "長方形の和を∫₀¹x dxへ変え、上下限と元の区間を結ぶ。",
      "equation": "∫₀¹ x dx = 1/2",
      "symbols": "xは入力、dxは入力方向の微小な幅を表す積分記号の一部。",
