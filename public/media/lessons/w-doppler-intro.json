  "sourceScript": "w-doppler-intro-draft",
  "scenes": [
    {
      "index": 0,
      "heading": "救急車が近づいてくると、次の音の山は、前の山より聞く人に近い場所から出ます。",
      "narration": "救急車が近づいてくると、次の音の山は、前の山より聞く人に近い場所から出ます。だから進む向きでは、山と山の間隔が狭くなります。",
      "visual": "等時間ごとの発音位置を点で残し、前方の波面間隔を示す。",
      "equation": "",
      "symbols": "",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 6.125,
          "text": "救急車が近づいてくると、次の音の山は、前の山より聞く人に近い場所から出ます。"
        },
        {
          "start": 6.125,
          "end": 10.25,
          "text": "だから進む向きでは、山と山の間隔が狭くなります。"
        }
      ],
      "end": 10.339333333333332
    },
    {
      "index": 1,
      "heading": "聞く人には、音の山がより短い間隔で届きます。",
      "narration": "聞く人には、音の山がより短い間隔で届きます。届く振動数は、救急車が出している振動数より大きくなります。",
      "visual": "発音時計と受信時計を並べ、到着間隔を測る。",
      "equation": "",
      "symbols": "",
      "start": 10.339333333333332,
      "captions": [
        {
          "start": 10.339333333333332,
          "end": 14.375,
          "text": "聞く人には、音の山がより短い間隔で届きます。"
        },
        {
          "start": 14.375,
          "end": 19.0,
          "text": "届く振動数は、救急車が出している振動数より大きくなります。"
        }
      ],
      "end": 19.110666666666667
    },
    {
      "index": 2,
      "heading": "救急車が音を出すペースは変わっていないのに、届く間隔だけが変わっています。",
      "narration": "救急車が音を出すペースは変わっていないのに、届く間隔だけが変わっています。「出す回数」と「届く回数」は、別のものです。",
      "visual": "音源の一定時計を固定し、受信の時計だけ変える。",
      "equation": "",
      "symbols": "",
      "start": 19.110666666666667,
      "captions": [
        {
          "start": 19.110666666666667,
          "end": 24.125,
          "text": "救急車が音を出すペースは変わっていないのに、届く間隔だけが変わっています。"
