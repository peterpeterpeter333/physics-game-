          ],
          [
            "r・r（矢印付き）",
            "電荷から面の点までの距離・位置ベクトル [m]"
          ],
          [
            "θ・φ",
            "球中心から測る極角・周方向の角度 [rad]"
          ],
          [
            "C",
            "球の中心の座標。電気容量ではない"
          ],
          [
            "n",
            "外向きの単位法線。長さ1で無次元"
          ],
          [
            "dA",
            "細かく区切った微小な面積 [m²]"
          ],
          [
            "S・∮S",
            "集計する閉曲面・その全面での積分"
          ],
          [
            "·",
            "対応する成分同士を掛けて足す内積"
          ],
          [
            "Q",
            "場を作る点電荷 [C]。正負を含む"
          ],
          [
            "k",
            "クーロンの定数1/(4πε₀) [N·m²/C²]"
          ],
          [
            "ε₀",
            "真空の誘電率 [F/m]"
          ],
          [
            "E・E（矢印付き）",
            "電場の大きさ・電場ベクトル [N/C]"
          ],
          [
            "ΦE",
            "閉曲面を外向きに貫く電気束 [N·m²/C]"
          ]
        ],
        "steps": [
          {
            "note": "球の位置と外向き法線を書く：同心球の座標のz成分にdを足すと、ずれた球の位置です。外向き法線はCから表面への単位ベクトルなので、n=(sinθ cosφ,sinθ sinφ,cosθ)になります。",
            "tex": "\\vec n=(\\sin\\theta\\cos\\varphi,\\sin\\theta\\sin\\varphi,\\cos\\theta)"
          },
          {
            "note": "電荷からの距離を計算する：三成分を二乗して足します。sin²θ＋cos²θ=1を使うとr²=R²＋d²＋2Rd cosθ。θによって変化するので、Eを一定として積分の外には出しません。",
            "tex": "r^2=R^2\\sin^2\\theta+(d+R\\cos\\theta)^2=R^2+d^2+2Rd\\cos\\theta"
          },
          {
            "note": "rとnの内積を成分で計算する：水平成分の積はR sin²θ、鉛直成分の積は(d＋R cosθ)cosθ。足すとR＋d cosθです。Eとnを平行だと仮定していません。",
            "tex": "\\vec r\\cdot\\vec n=R\\sin^2\\theta+(d+R\\cos\\theta)\\cos\\theta=R+d\\cos\\theta"
          },
          {
            "note": "電場の分母も代入する：E·n=kQ(r·n)/r³へ、さきほどの距離と内積を代入します。強さが変化することと法線との角度が変化することの両方が入っています。",
            "tex": "\\vec E\\cdot\\vec n=kQ\\frac{R+d\\cos\\theta}{(R^2+d^2+2Rd\\cos\\theta)^{3/2}}"
          },
          {
            "note": "面積要素を掛け、φを積分する：dA=R² sinθ dθ dφを掛けます。軸の周りの角度φには依存しないので、φの0〜2πの積分だけ先に行えます。θの積分は省略せず次へ進めます。",
            "tex": "\\Phi_E=kQR^2\\int_0^{2\\pi}d\\varphi\\int_0^\\pi\\frac{(R+d\\cos\\theta)\\sin\\theta}{(R^2+d^2+2Rd\\cos\\theta)^{3/2}}d\\theta"
          }
        ]
