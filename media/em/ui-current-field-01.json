  "scenes": [
    {
      "index": 0,
      "heading": "復習：直線電流の周りを磁場が回る",
      "narration": "直線電流の周りの磁場は、導線を中心とする円に沿う向きです。右手の親指を電流の向きへ向けると、曲げた四本の指が磁場の向きを示します。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.068666666666667,
          "text": "直線電流の周りの磁場は、導線を中心とする円に沿う向きです。"
        },
        {
          "start": 5.218666666666667,
          "end": 11.087333333333333,
          "text": "右手の親指を電流の向きへ向けると、曲げた四本の指が磁場の向きを示します。"
        }
      ],
      "end": 12.437333333333331
    },
    {
      "index": 1,
      "heading": "復習：コイルは各部分の磁場を重ねる",
      "narration": "円形コイルの各部分を流れる電流は、コイルの中心に磁場を作ります。中心では、それぞれの磁場が、コイルの面に垂直な同じ向きになります。そのため、中心の磁場の強さは、各部分が作る強さを足して求められます。",
      "equations": [
        "B=B_1+B_2",
        "B=b+b=2b"
      ],
      "spatial": false,
      "start": 12.437333333333331,
      "captions": [
        {
          "start": 12.437333333333331,
          "end": 17.665999999999997,
          "text": "円形コイルの各部分を流れる電流は、コイルの中心に磁場を作ります。"
        },
        {
          "start": 17.816,
          "end": 23.172666666666665,
          "text": "中心では、それぞれの磁場が、コイルの面に垂直な同じ向きになります。"
        },
        {
          "start": 23.322666666666663,
          "end": 29.180666666666664,
          "text": "そのため、中心の磁場の強さは、各部分が作る強さを足して求められます。"
        }
      ],
      "end": 30.53066666666666
    },
    {
      "index": 2,
      "heading": "復習：全巻数と1mあたりの巻数は違う",
      "narration": "巻数密度は、コイルを一メートルあたり何回巻いたかを表します。巻数密度は、全巻数をコイルの長さで割った値です。長いコイルの中央の磁場を計算するとき、この値を使います。",
      "equations": [
        "n=\\frac Nl",
        "N_L=nL"
      ],
      "spatial": false,
      "start": 30.53066666666666,
      "captions": [
        {
          "start": 30.53066666666666,
          "end": 35.300666666666665,
          "text": "巻数密度は、コイルを一メートルあたり何回巻いたかを表します。"
        },
        {
          "start": 35.45066666666666,
          "end": 39.623333333333335,
          "text": "巻数密度は、全巻数をコイルの長さで割った値です。"
        },
        {
          "start": 39.773333333333326,
          "end": 44.276666666666664,
          "text": "長いコイルの中央の磁場を計算するとき、この値を使います。"
        }
      ],
      "end": 45.626666666666665
    }
  ],
