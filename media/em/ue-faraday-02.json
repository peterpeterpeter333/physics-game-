  "scenes": [
    {
      "index": 3,
      "heading": "触れずにエネルギーを渡せるのは、なぜだろう? — 相互誘導",
      "narration": "一次コイルの電流が変わると、二次コイルを貫く磁束も変わります。その変化で、二次コイルに起電力が生じます。この仕組みで、一次側の電源から二次側へ、導線でつながずにエネルギーを渡せます。",
      "equations": [
        "V_2 = -M\\frac{dI_1}{dt}"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.004666666666667,
          "text": "一次コイルの電流が変わると、二次コイルを貫く磁束も変わります。"
        },
        {
          "start": 5.1546666666666665,
          "end": 8.868666666666666,
          "text": "その変化で、二次コイルに起電力が生じます。"
        },
        {
          "start": 9.018666666666666,
          "end": 15.260666666666665,
          "text": "この仕組みで、一次側の電源から二次側へ、導線でつながずにエネルギーを渡せます。"
        }
      ],
      "end": 16.610666666666667
    },
    {
      "index": 4,
      "heading": "変圧器の巻数比と電流比",
      "narration": "理想的な変圧器では、一次と二次の電圧の比は、巻数の比に等しくなります。損失がなければ、一次と二次の電力も同じです。だから、「一次の電流割る二次の電流」は、「二次の巻数割る一次の巻数」になります。",
      "equations": [
        "\\frac{|V_2|}{|V_1|}=\\frac{N_2}{N_1},\\qquad\\frac{|I_2|}{|I_1|}=\\frac{N_1}{N_2}",
        "|V_1|=N_1a,\\quad|V_2|=N_2a",
        "\\frac{|V_2|}{|V_1|}=\\frac{N_2\\cancel a}{N_1\\cancel a}=\\frac{N_2}{N_1}",
        "|V_1||I_1|=|V_2||I_2|",
        "\\frac{|I_2|}{|I_1|}=\\frac{|V_1|}{|V_2|}=\\frac{N_1}{N_2}"
      ],
      "spatial": false,
      "start": 16.610666666666667,
      "captions": [
        {
          "start": 16.610666666666667,
          "end": 22.522,
          "text": "理想的な変圧器では、一次と二次の電圧の比は、巻数の比に等しくなります。"
        },
        {
          "start": 22.672,
          "end": 26.674,
          "text": "損失がなければ、一次と二次の電力も同じです。"
        },
        {
          "start": 26.824,
          "end": 33.40733333333334,
          "text": "だから、「一次の電流割る二次の電流」は、「二次の巻数割る一次の巻数」になります。"
        }
      ],
      "end": 34.757333333333335
    },
    {
      "index": 5,
      "heading": "相互インダクタンスの定義から誘導へ",
      "narration": "二つ目のコイルの鎖交磁束を、「一つ目の電流かける相互インダクタンス」で表します。この磁束の式を、ファラデーの法則に入れます。相互インダクタンスが一定なら、二つ目の起電力は、「その定数かける、一つ目の電流の時間微分」にマイナスを付けたものです。",
      "equations": [
        "\\Psi_2=MI_1",
        "\\mathcal E_2=-\\frac{d\\Psi_2}{dt}",
        "\\mathcal E_2=-\\frac d{dt}(MI_1)=-M\\frac{dI_1}{dt}"
      ],
      "spatial": false,
      "start": 34.757333333333335,
      "captions": [
        {
          "start": 34.757333333333335,
          "end": 40.882000000000005,
          "text": "二つ目のコイルの鎖交磁束を、「一つ目の電流かける相互インダクタンス」で表します。"
        },
        {
          "start": 41.032000000000004,
          "end": 44.564666666666675,
          "text": "この磁束の式を、ファラデーの法則に入れます。"
        },
        {
          "start": 44.71466666666667,
          "end": 53.62333333333334,
          "text": "相互インダクタンスが一定なら、二つ目の起電力は、「その定数かける、一つ目の電流の時間微分」にマイナスを付けたものです。"
        }
      ],
      "end": 54.97333333333334
    }
