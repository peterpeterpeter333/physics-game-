  "scenes": [
    {
      "index": 2,
      "heading": "直線電流の磁場は、なぜ1行で出るのだろう?",
      "narration": "無限に長いまっすぐな電流の磁場は、電流を中心とする円に沿った向きです。同じ半径の円周の上では強さがどこでも同じなので、一周の積分は「磁場かける円周」になります。",
      "equations": [
        "B = \\dfrac{\\mu_0 I}{2\\pi r}",
        "\\oint\\vec B\\cdot d\\vec r=\\mu_0I",
        "B\\oint dl=\\mu_0I",
        "B(2\\pi r)=\\mu_0I",
        "B=\\frac{\\mu_0I}{2\\pi r}"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.538,
          "text": "無限に長いまっすぐな電流の磁場は、電流を中心とする円に沿った向きです。"
        },
        {
          "start": 5.688,
          "end": 13.241999999999999,
          "text": "同じ半径の円周の上では強さがどこでも同じなので、一周の積分は「磁場かける円周」になります。"
        }
      ],
      "end": 14.591999999999999
    },
    {
      "index": 3,
      "heading": "積分からBを外せる根拠",
      "narration": "アンペールの法則では、この一周の積分は、透磁率かける電流に等しくなります。一方、一周の積分は磁場の強さかける二パイアールです。両辺を二パイアールで割ると、長い直線電流がつくる磁場の式が求まります。",
      "equations": [
        "\\oint\\vec B\\cdot d\\vec r=\\mu_0I",
        "B\\oint dl=\\mu_0I",
        "B(2\\pi r)=\\mu_0I",
        "B=\\frac{\\mu_0I}{2\\pi r}"
      ],
      "spatial": false,
      "start": 14.591999999999999,
      "captions": [
        {
          "start": 14.591999999999999,
          "end": 20.609999999999996,
          "text": "アンペールの法則では、この一周の積分は、透磁率かける電流に等しくなります。"
        },
        {
          "start": 20.759999999999998,
          "end": 25.284666666666663,
          "text": "一方、一周の積分は磁場の強さかける二パイアールです。"
        },
        {
          "start": 25.434666666666665,
          "end": 30.88733333333333,
          "text": "両辺を二パイアールで割ると、長い直線電流がつくる磁場の式が求まります。"
        }
      ],
      "end": 32.23733333333333
    },
    {
      "index": 4,
      "heading": "直線の式を半径について読む",
      "narration": "まっすぐな導線から、調べる点までの距離をアールとします。磁場の強さはこの距離に反比例するので、距離が二倍なら強さは半分です。ここでのアールは、導線そのものの太さではありません。",
      "equations": [
        "\\oint\\vec B\\cdot d\\vec r=\\mu_0I",
        "B\\oint dl=\\mu_0I",
        "B(2\\pi r)=\\mu_0I",
        "B=\\frac{\\mu_0I}{2\\pi r}"
      ],
      "spatial": false,
      "start": 32.23733333333333,
      "captions": [
        {
          "start": 32.23733333333333,
          "end": 36.516666666666666,
          "text": "まっすぐな導線から、調べる点までの距離をアールとします。"
        },
        {
          "start": 36.666666666666664,
          "end": 42.11933333333333,
          "text": "磁場の強さはこの距離に反比例するので、距離が二倍なら強さは半分です。"
        },
        {
          "start": 42.26933333333333,
          "end": 46.196666666666665,
          "text": "ここでのアールは、導線そのものの太さではありません。"
