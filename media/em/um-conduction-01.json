  "scenes": [
    {
      "index": 0,
      "heading": "nは1m³に何個あるか",
      "narration": "電子の数密度とは、一立方メートルあたりの電子の個数です。電子一個の電荷はマイナスで、記号イーはその大きさを表すプラスの数です。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.333333333333333,
          "text": "電子の数密度とは、一立方メートルあたりの電子の個数です。"
        },
        {
          "start": 4.333333333333333,
          "end": 9.541666666666668,
          "text": "電子一個の電荷はマイナスで、記号イーはその大きさを表すプラスの数です。"
        }
      ],
      "end": 9.666333333333334
    },
    {
      "index": 1,
      "heading": "電子は遅いのに、なぜ一瞬で点灯するのだろう?",
      "narration": "電子は不規則に動きながら、平均すると一方向へ少しずつ進みます。ここで使うのは、その平均の進み方の速さです。断面積に、この速さと一秒を掛けると、一秒間の正味の移動に対応する体積が求まります。数密度と電子一個の電荷の大きさも掛けると、一秒あたりに通る電荷、つまり電流の大きさが分かります。",
      "equations": [
        "I = enSv"
      ],
      "spatial": false,
      "start": 9.666333333333334,
      "captions": [
        {
          "start": 9.666333333333334,
          "end": 14.541666666666668,
          "text": "電子は不規則に動きながら、平均すると一方向へ少しずつ進みます。"
        },
        {
          "start": 14.541666666666668,
          "end": 18.041666666666668,
          "text": "ここで使うのは、その平均の進み方の速さです。"
        },
        {
          "start": 18.041666666666668,
          "end": 24.833333333333332,
          "text": "断面積に、この速さと一秒を掛けると、一秒間の正味の移動に対応する体積が求まります。"
        },
        {
          "start": 24.833333333333332,
          "end": 32.181333333333335,
          "text": "数密度と電子一個の電荷の大きさも掛けると、一秒あたりに通る電荷、つまり電流の大きさが分かります。"
        }
      ],
      "end": 33.53133333333333
    }
  ],
