  "scenes": [
    {
      "index": 0,
      "heading": "半径と周期を順に導く",
      "narration": "磁場と垂直に動く粒子では、磁気力が円運動の向心力になります。周期は、円周の長さを粒子の速さで割った値です。この式へ円運動の半径を代入すると、速さが約分され、周期は速さによらなくなります。",
      "equations": [
        "r=\\frac{mv_\\perp}{|q|B},\\qquad T=\\frac{2\\pi m}{|q|B}",
        "|q|v_\\perp B=\\frac{mv_\\perp^2}{r}",
        "|q|Br=mv_\\perp",
        "r=\\frac{mv_\\perp}{|q|B}",
        "T=\\frac{2\\pi r}{v_\\perp}",
        "T=\\frac{2\\pi m\\cancel{v_\\perp}}{|q|B\\cancel{v_\\perp}}=\\frac{2\\pi m}{|q|B}"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.314,
          "text": "磁場と垂直に動く粒子では、磁気力が円運動の向心力になります。"
        },
        {
          "start": 5.4639999999999995,
          "end": 9.711333333333332,
          "text": "周期は、円周の長さを粒子の速さで割った値です。"
        },
        {
          "start": 9.861333333333333,
          "end": 16.465999999999998,
          "text": "この式へ円運動の半径を代入すると、速さが約分され、周期は速さによらなくなります。"
        }
      ],
      "end": 17.816
    },
    {
      "index": 1,
      "heading": "モーターはなぜ回るのだろう? — 電流が受ける力",
      "narration": "導線の磁気力は、電流方向を向く長さベクトルと磁場の外積に、電流を掛けたものです。コイルでは、反対側の導線に逆向きの力が働きます。この力の組がコイルを回す働きをし、その大きさをトルクで表します。",
      "equations": [
        "\\vec{F} = I\\vec{L}\\times\\vec{B}",
        "F = BIl"
      ],
      "spatial": false,
      "start": 17.816,
      "captions": [
        {
          "start": 17.816,
          "end": 24.452666666666666,
          "text": "導線の磁気力は、電流方向を向く長さベクトルと磁場の外積に、電流を掛けたものです。"
        },
        {
          "start": 24.602666666666664,
          "end": 29.28733333333333,
          "text": "コイルでは、反対側の導線に逆向きの力が働きます。"
        },
        {
          "start": 29.43733333333333,
          "end": 34.80466666666667,
          "text": "この力の組がコイルを回す働きをし、その大きさをトルクで表します。"
        }
      ],
      "end": 36.15466666666667
    },
    {
      "index": 2,
      "heading": "導線に含まれる粒子の力を足す",
      "narration": "導線全体の磁気力は、区間内の荷電粒子が受ける磁気力の合計です。粒子の数と電荷と速度を電流の式でまとめると、導線の力の式になります。",
      "equations": [
        "\\vec F=I\\vec l\\times\\vec B",
        "N=nSl",
        "\\vec F=nSlq(\\vec v\\times\\vec B)"
      ],
      "spatial": false,
      "start": 36.15466666666667,
      "captions": [
        {
          "start": 36.15466666666667,
          "end": 41.55400000000001,
          "text": "導線全体の磁気力は、区間内の荷電粒子が受ける磁気力の合計です。"
        },
        {
          "start": 41.70400000000001,
          "end": 47.41266666666668,
          "text": "粒子の数と電荷と速度を電流の式でまとめると、導線の力の式になります。"
        }
      ],
      "end": 48.762666666666675
    }
