        ],
        "steps": [
          {
            "note": "ラジアンの定義。弧が半径と同じ長さなら角度は1 rad。",
            "tex": "\\Delta\\theta=\\frac{\\Delta s}{R}"
          },
          {
            "note": "両辺に同じ半径Rを掛け、右辺のRを約分する。",
            "tex": "R\\,\\Delta\\theta=R\\frac{\\Delta s}{R}=\\Delta s"
          },
          {
            "note": "半径2 m、角度の変化0.1 radなら、表面に沿った長さは0.2 m。",
            "tex": "\\Delta s=(2\\,\\mathrm m)\\times0.1=0.2\\,\\mathrm m"
          },
          {
            "note": "半径は一定。角度あたりの長さの変化は、区間を縮めてもR。極限を微分と呼ぶ。",
            "tex": "\\frac{ds}{d\\theta}=\\lim_{\\Delta\\theta\\to0}\\frac{\\Delta s}{\\Delta\\theta}=R"
          },
          {
            "note": "微分の関係をds＝R dθと書く。dsは微小な長さ、dθは対応する角度の微小な変化。",
            "tex": "ds=R\\,d\\theta"
          },
          {
            "note": "θは北極から南極まで半周、φは軸の周りに一周。",
            "tex": "0\\le\\theta\\le\\pi,\\qquad0\\le\\varphi\\le2\\pi"
