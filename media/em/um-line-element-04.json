  "scenes": [
    {
      "index": 11,
      "heading": "同じ向きと直角では、値はどう変わるのだろう?",
      "narration": "力の大きさと移動距離を固定して、角度だけを変えて比べます。力と移動が同じ向きなら、仕事はプラスで最大です。二つの向きが直角なら、仕事はゼロです。",
      "equations": [
        "\\cos0^\\circ=1",
        "\\cos90^\\circ=0"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.663333333333333,
          "text": "力の大きさと移動距離を固定して、角度だけを変えて比べます。"
        },
        {
          "start": 4.813333333333333,
          "end": 9.039333333333332,
          "text": "力と移動が同じ向きなら、仕事はプラスで最大です。"
        },
        {
          "start": 9.189333333333332,
          "end": 12.679333333333332,
          "text": "二つの向きが直角なら、仕事はゼロです。"
        }
      ],
      "end": 14.029333333333332
    },
    {
      "index": 12,
      "heading": "逆を向いた区間では、符号はどうなるのだろう?",
      "narration": "力と移動が逆向きなら、その力の仕事はマイナスです。この力は、物体の運動エネルギーを減らす働きをします。他の力も働く場合、運動エネルギーの変化は全ての力の仕事を足した値です。",
      "equations": [
        "\\cos180^\\circ=-1"
      ],
      "spatial": false,
      "start": 14.029333333333332,
      "captions": [
        {
          "start": 14.029333333333332,
          "end": 18.44733333333333,
          "text": "力と移動が逆向きなら、その力の仕事はマイナスです。"
        },
        {
          "start": 18.59733333333333,
          "end": 23.036666666666665,
          "text": "この力は、物体の運動エネルギーを減らす働きをします。"
        },
        {
          "start": 23.186666666666664,
          "end": 29.17266666666666,
          "text": "他の力も働く場合、運動エネルギーの変化は全ての力の仕事を足した値です。"
        }
      ],
      "end": 30.522666666666662
    },
    {
      "index": 13,
      "heading": "大きさどうしを掛けるのでは、なぜいけないのだろう?",
      "narration": "力の大きさと移動距離だけを掛ける式は、二つの向きが同じ場合の仕事です。コサインシータを掛けると、角度に応じて仕事がプラス、ゼロ、マイナスになります。",
      "equations": [],
      "spatial": false,
      "start": 30.522666666666662,
      "captions": [
        {
          "start": 30.522666666666662,
          "end": 36.092666666666666,
          "text": "力の大きさと移動距離だけを掛ける式は、二つの向きが同じ場合の仕事です。"
        },
        {
          "start": 36.242666666666665,
          "end": 42.239333333333335,
          "text": "コサインシータを掛けると、角度に応じて仕事がプラス、ゼロ、マイナスになります。"
