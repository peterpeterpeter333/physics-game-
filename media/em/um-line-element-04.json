  "scenes": [
    {
      "index": 11,
      "heading": "同じ向きと直角では、値はどう変わるのだろう?",
      "narration": "力の大きさと移動距離を固定して、角度だけを変えて比べます。力と移動が同じ向きなら、仕事はプラスで最大です。二つが直角なら、仕事はゼロです。",
      "equations": [
        "\\cos0^\\circ=1",
        "\\cos90^\\circ=0"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.333333333333333,
          "text": "力の大きさと移動距離を固定して、角度だけを変えて比べます。"
        },
        {
          "start": 4.333333333333333,
          "end": 8.125,
          "text": "力と移動が同じ向きなら、仕事はプラスで最大です。"
        },
        {
          "start": 8.125,
          "end": 11.083333333333334,
          "text": "二つが直角なら、仕事はゼロです。"
        }
      ],
      "end": 11.209333333333332
    },
    {
      "index": 12,
      "heading": "逆を向いた区間では、符号はどうなるのだろう?",
      "narration": "力と移動が逆向きなら、その力の仕事はマイナスです。この力は、物体の運動エネルギーを減らす働きをします。ほかの力も働く場合、運動エネルギーの変化は、全部の力の仕事を足したものです。",
      "equations": [
        "\\cos180^\\circ=-1"
      ],
      "spatial": false,
      "start": 11.209333333333332,
      "captions": [
        {
          "start": 11.209333333333332,
          "end": 15.291666666666668,
          "text": "力と移動が逆向きなら、その力の仕事はマイナスです。"
        },
        {
          "start": 15.291666666666668,
          "end": 19.291666666666668,
          "text": "この力は、物体の運動エネルギーを減らす働きをします。"
        },
        {
          "start": 19.291666666666668,
          "end": 25.541666666666668,
          "text": "ほかの力も働く場合、運動エネルギーの変化は、全部の力の仕事を足したものです。"
        }
      ],
      "end": 25.641
    },
    {
      "index": 13,
      "heading": "大きさどうしを掛けるのでは、なぜいけないのだろう?",
      "narration": "「力の大きさかける移動距離」だけの式は、二つが同じ向きのときの仕事です。コサインシータを掛けると、角度に応じて仕事がプラス、ゼロ、マイナスになります。",
      "equations": [],
      "spatial": false,
      "start": 25.641,
      "captions": [
        {
          "start": 25.641,
          "end": 31.208333333333336,
          "text": "「力の大きさかける移動距離」だけの式は、二つが同じ向きのときの仕事です。"
        },
        {
          "start": 31.208333333333336,
          "end": 37.09433333333333,
          "text": "コサインシータを掛けると、角度に応じて仕事がプラス、ゼロ、マイナスになります。"
