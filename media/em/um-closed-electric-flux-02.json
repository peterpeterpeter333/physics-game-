      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 3.7083333333333335,
          "text": "左の面の外向き法線は、電場と逆向きです。"
        },
        {
          "start": 3.7083333333333335,
          "end": 9.125,
          "text": "電場と法線の内積はマイナスなので、左の面の電気束の分もマイナスです。"
        }
      ],
      "end": 9.229
