  "scenes": [
    {
      "index": 0,
      "heading": "オームの法則は、なぜ「比例」なのだろう?",
      "narration": "電子の平均の流れは、電場による加速と散乱による運動量の損失で決まります。このモデルの定常状態では、電流密度は電場に比例します。",
      "equations": [
        "\\vec{j} = \\sigma\\vec{E}"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.783333333333333,
          "text": "電子の平均の流れは、電場による加速と散乱による運動量の損失で決まります。"
        },
        {
          "start": 5.933333333333333,
          "end": 10.660666666666664,
          "text": "このモデルの定常状態では、電流密度は電場に比例します。"
        }
      ],
      "end": 12.010666666666665
    },
    {
      "index": 1,
      "heading": "衝突モデルからドリフト速度へ",
      "narration": "電子の平均運動の式は、電気力と平均的な散乱の効果を含みます。定常状態の平均速度は、電子の負の電荷のため電場と逆向きです。",
      "equations": [
        "m\\dot{\\vec v}=-e\\vec E-\\frac m\\tau\\vec v",
        "0=-e\\vec E-\\frac m\\tau\\vec v",
        "\\frac m\\tau\\vec v=-e\\vec E",
        "\\vec v=-\\frac{e\\tau}{m}\\vec E"
      ],
      "spatial": false,
      "start": 12.010666666666665,
      "captions": [
        {
          "start": 12.010666666666665,
          "end": 17.474,
          "text": "電子の平均運動の式は、電気力と平均的な散乱の効果を含みます。"
        },
        {
          "start": 17.624,
          "end": 23.044666666666664,
          "text": "定常状態の平均速度は、電子の負の電荷のため電場と逆向きです。"
        }
      ],
      "end": 24.394666666666662
    },
    {
      "index": 2,
      "heading": "電子の流れを電流密度に変える",
      "narration": "電流密度は、粒子の数密度と電荷と平均速度の積です。電子の速度の式を代入した結果では負号が相殺し、電流密度は電場と同じ向きになります。",
      "equations": [
        "\\vec j=\\frac{ne^2\\tau}{m}\\vec E=\\sigma\\vec E",
        "\\vec j=-ne\\vec v",
        "\\vec j=-ne\\left(-\\frac{e\\tau}{m}\\vec E\\right)",
        "\\vec j=\\frac{ne^2\\tau}{m}\\vec E",
        "\\sigma=\\frac{ne^2\\tau}{m},\\quad\\vec j=\\sigma\\vec E"
      ],
      "spatial": false,
      "start": 24.394666666666662,
      "captions": [
        {
          "start": 24.394666666666662,
          "end": 29.175333333333327,
          "text": "電流密度は、粒子の数密度と電荷と平均速度の積です。"
        },
        {
          "start": 29.32533333333333,
          "end": 35.919333333333334,
          "text": "電子の速度の式を代入した結果では負号が相殺し、電流密度は電場と同じ向きになります。"
        }
      ],
      "end": 37.269333333333336
    },
    {
      "index": 3,
      "heading": "局所の式からV=RIへ",
      "narration": "一様な導線の電流は、電流密度と断面積の積です。電場を電圧と長さの比に直すと、導線の抵抗は抵抗率と長さの積を断面積で割った値になります。",
      "equations": [
        "R=\\rho\\frac{l}{S}",
        "I=jS",
        "I=\\sigma\\frac Vl S",
        "V=\\frac l{\\sigma S}I",
        "R=\\frac l{\\sigma S}",
        "R=\\rho\\frac lS"
      ],
      "spatial": false,
      "start": 37.269333333333336,
      "captions": [
        {
          "start": 37.269333333333336,
          "end": 41.858000000000004,
          "text": "一様な導線の電流は、電流密度と断面積の積です。"
        },
        {
          "start": 42.008,
