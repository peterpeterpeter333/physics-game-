  "scenes": [
    {
      "index": 0,
      "heading": "球面で囲むとき、どちらを正と決めるのだろう?",
      "narration": "この球面は、計算のために頭の中で描いた球の表面です。電荷のまわりに実物を置くわけではないので、電場は変わりません。法線の向きは、球の中心から外向きに選びます。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.458333333333333,
          "text": "この球面は、計算のために頭の中で描いた球の表面です。"
        },
        {
          "start": 4.458333333333333,
          "end": 8.833333333333332,
          "text": "電荷のまわりに実物を置くわけではないので、電場は変わりません。"
        },
        {
          "start": 8.833333333333332,
          "end": 12.833333333333332,
          "text": "法線の向きは、球の中心から外向きに選びます。"
        }
      ],
      "end": 12.936333333333332
    },
    {
      "index": 1,
      "heading": "中心に正の電荷を1個入れると、どうなるのだろう?",
      "narration": "中心のプラスの電荷が作る電場は、球面のどの点でも外向きです。図の矢印は電場の向きを示すために描いています。矢印の本数は、本当にある粒子の数ではなく、電気束の値そのものでもありません。",
      "equations": [],
      "spatial": false,
      "start": 12.936333333333332,
      "captions": [
        {
          "start": 12.936333333333332,
          "end": 17.666666666666664,
          "text": "中心のプラスの電荷が作る電場は、球面のどの点でも外向きです。"
        },
        {
          "start": 17.666666666666664,
          "end": 21.041666666666664,
          "text": "図の矢印は電場の向きを示すために描いています。"
        },
        {
          "start": 21.041666666666664,
          "end": 27.125,
          "text": "矢印の本数は、本当にある粒子の数ではなく、電気束の値そのものでもありません。"
        }
      ],
      "end": 27.21566666666667
    },
    {
      "index": 2,
      "heading": "電荷を2倍にすると、出ていく量はどうなるのだろう?",
      "narration": "中心の電荷が二倍になると、同じ球面上の電場も二倍になります。面積は同じなので、球面全体の電気束も二倍です。",
      "equations": [
        "E\\to 2E",
        "\\Phi_{\\text{正味}}\\to 2\\Phi_{\\text{正味}}"
      ],
      "spatial": false,
      "start": 27.21566666666667,
      "captions": [
        {
          "start": 27.21566666666667,
          "end": 32.0,
          "text": "中心の電荷が二倍になると、同じ球面上の電場も二倍になります。"
        },
        {
          "start": 32.0,
          "end": 36.37566666666667,
          "text": "面積は同じなので、球面全体の電気束も二倍です。"
        }
      ],
      "end": 37.72566666666667
    }
  ],
