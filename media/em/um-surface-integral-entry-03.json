  "scenes": [
    {
      "index": 6,
      "heading": "$dA$ と $d\\vec A$ は、どう区別するのだろう?",
      "narration": "ごく小さな面積は、小さな広さだけを表します。ごく小さな面積ベクトルは、「単位法線かける、ごく小さな面積」で、向きも含みます。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 3.7916666666666665,
          "text": "ごく小さな面積は、小さな広さだけを表します。"
        },
        {
          "start": 3.7916666666666665,
          "end": 10.5,
          "text": "ごく小さな面積ベクトルは、「単位法線かける、ごく小さな面積」で、向きも含みます。"
        }
      ],
      "end": 10.646666666666665
    },
    {
      "index": 7,
      "heading": "面積分は、面積を掛ける操作なのだろうか?",
      "narration": "磁束の面積分では、各点の「磁場の法線方向の分かける、ごく小さな面積」を足します。法線方向の分が面の上でどこも同じなら、その値に全面積を掛けるだけで計算できます。場所ごとに違うなら、この単純な掛け算は使えません。",
      "equations": [],
      "spatial": false,
      "start": 10.646666666666665,
      "captions": [
        {
          "start": 10.646666666666665,
          "end": 17.958333333333332,
          "text": "磁束の面積分では、各点の「磁場の法線方向の分かける、ごく小さな面積」を足します。"
        },
        {
          "start": 17.958333333333332,
          "end": 24.041666666666664,
          "text": "法線方向の分が面の上でどこも同じなら、その値に全面積を掛けるだけで計算できます。"
        },
        {
          "start": 24.041666666666664,
          "end": 28.083333333333332,
          "text": "場所ごとに違うなら、この単純な掛け算は使えません。"
        }
      ],
      "end": 28.168666666666667
    },
    {
      "index": 8,
      "heading": "丸の付いた積分記号は、どう使い分けるのだろう?",
      "narration": "積分記号に付いた丸は、道や面が閉じていることを表します。ごく短い移動ベクトルを使う式は、道に沿った積分です。ごく小さな面積ベクトルを使う式は、面についての積分です。",
      "equations": [
        "\\oint_C\\vec E\\cdot d\\vec r,\\qquad \\oiint_S\\vec B\\cdot d\\vec A"
      ],
      "spatial": false,
      "start": 28.168666666666667,
      "captions": [
        {
          "start": 28.168666666666667,
          "end": 32.541666666666664,
          "text": "積分記号に付いた丸は、道や面が閉じていることを表します。"
        },
        {
          "start": 32.541666666666664,
          "end": 36.62499999999999,
          "text": "ごく短い移動ベクトルを使う式は、道に沿った積分です。"
        },
        {
          "start": 36.62499999999999,
          "end": 41.20833333333332,
          "text": "ごく小さな面積ベクトルを使う式は、面についての積分です。"
        }
      ],
      "end": 41.34933333333333
    },
    {
      "index": 9,
      "heading": "閉じていない面に、$\\oiint$ を使ってよいのだろうか?",
      "narration": "円板のように縁がある面と、球の表面のように空間を包んでしまう面は区別します。後者を閉曲面と呼びます。この教材では、閉曲面の法線は外向きに選び、面全体で積分します。",
      "equations": [],
      "spatial": false,
      "start": 41.34933333333333,
      "captions": [
        {
          "start": 41.34933333333333,
          "end": 46.95833333333332,
          "text": "円板のように縁がある面と、球の表面のように空間を包んでしまう面は区別します。"
        },
        {
          "start": 46.95833333333332,
          "end": 49.04166666666666,
          "text": "後者を閉曲面と呼びます。"
        },
        {
          "start": 49.04166666666666,
          "end": 54.79166666666666,
          "text": "この教材では、閉曲面の法線は外向きに選び、面全体で積分します。"
        }
      ],
      "end": 56.14166666666666
    }
  ],
