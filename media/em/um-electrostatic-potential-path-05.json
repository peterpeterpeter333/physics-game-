  "scenes": [
    {
      "index": 10,
      "heading": "電位差の単位は、電場の単位とどうつながるのだろう?",
      "narration": "「電場かける移動距離」の単位は、ジュール毎クーロンです。これがボルトなので、電場の単位は「ボルト毎メートル」とも書けます。",
      "equations": [
        "\\mathrm{N/C}\\times\\mathrm m=\\mathrm{J/C}=\\mathrm V"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 3.9583333333333335,
          "text": "「電場かける移動距離」の単位は、ジュール毎クーロンです。"
        },
        {
          "start": 3.9583333333333335,
          "end": 8.958333333333332,
          "text": "これがボルトなので、電場の単位は「ボルト毎メートル」とも書けます。"
        }
      ],
      "end": 9.059333333333331
    },
    {
      "index": 11,
      "heading": "電位は、どんなふうに読めばよいのだろう?",
      "narration": "この例の終点の電位は、始点より十二ボルト低くなります。図に書いた電位の数字は、各場所の電位です。この値は、空間の高さを表しているのではありません。",
      "equations": [
        "-24/2=-12\\,\\mathrm V"
      ],
      "spatial": false,
      "start": 9.059333333333331,
      "captions": [
        {
          "start": 9.059333333333331,
          "end": 13.208333333333332,
          "text": "この例の終点の電位は、始点より十二ボルト低くなります。"
        },
        {
          "start": 13.208333333333332,
          "end": 16.416666666666668,
          "text": "図に書いた電位の数字は、各場所の電位です。"
        },
        {
          "start": 16.416666666666668,
          "end": 20.333333333333336,
          "text": "この値は、空間の高さを表しているのではありません。"
        }
      ],
      "end": 20.490666666666662
    },
    {
      "index": 12,
      "heading": "この作り方が使えないのは、どんなときだろう?",
      "narration": "磁束が時間で変わると、一周に沿った電場の仕事が打ち消し合わないことがあります。その場合、一周の線積分はゼロではありません。その電場全体を、静電位の差だけで表すことはできません。",
      "equations": [],
      "spatial": false,
      "start": 20.490666666666662,
      "captions": [
        {
          "start": 20.490666666666662,
          "end": 25.916666666666664,
          "text": "磁束が時間で変わると、一周に沿った電場の仕事が打ち消し合わないことがあります。"
        },
        {
          "start": 25.916666666666664,
          "end": 29.333333333333336,
          "text": "その場合、一周の線積分はゼロではありません。"
        },
        {
          "start": 29.333333333333336,
          "end": 33.655666666666676,
          "text": "その電場全体を、静電位の差だけで表すことはできません。"
        }
      ],
      "end": 35.00566666666667
    }
