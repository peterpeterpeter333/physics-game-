  "scenes": [
    {
      "index": 0,
      "heading": "電位差と一周の起電力は別",
      "narration": "静電場の一周の線積分はゼロですが、変動磁束による電場ではゼロとは限りません。この一周の起電力は、二点間の静電位差とは別の量です。",
      "equations": [
        "\\oint\\vec E\\cdot d\\vec r=-\\frac{d\\Phi_B}{dt}"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 6.21,
          "text": "静電場の一周の線積分はゼロですが、変動磁束による電場ではゼロとは限りません。"
        },
        {
          "start": 6.359999999999999,
          "end": 11.076666666666664,
          "text": "この一周の起電力は、二点間の静電位差とは別の量です。"
        }
      ],
      "end": 12.426666666666666
    },
    {
      "index": 1,
      "heading": "起電力は、なぜ「変化率」で決まるのだろう?",
      "narration": "面の法線と道を回る向きは、右手の約束で組にして選びます。ファラデーの法則のマイナスは、その向きの約束で磁束の変化と起電力を結びます。閉回路では、誘導電流が作る磁場が、元の磁束の変化を妨げます。",
      "equations": [
        "\\mathcal E=-\\frac{d\\Phi_B}{dt}"
      ],
      "spatial": false,
      "start": 12.426666666666666,
      "captions": [
        {
          "start": 12.426666666666666,
          "end": 17.538,
          "text": "面の法線と道を回る向きは、右手の約束で組にして選びます。"
        },
        {
          "start": 17.688,
          "end": 23.482,
          "text": "ファラデーの法則のマイナスは、その向きの約束で磁束の変化と起電力を結びます。"
        },
        {
          "start": 23.631999999999998,
          "end": 29.201999999999998,
          "text": "閉回路では、誘導電流が作る磁場が、元の磁束の変化を妨げます。"
        }
      ],
      "end": 30.551999999999996
    },
    {
      "index": 2,
      "heading": "N巻きでは磁束鎖交数を使う",
      "narration": "コイルの各一周が囲む面を通る磁束が、どれも同じだとします。一巻きごとの起電力を足すと、全体の起電力は一巻きの値の巻数倍です。磁束が導線そのものを通る、という意味ではありません。",
      "equations": [
        "\\Psi=N\\Phi",
        "\\mathcal E=-\\frac{d\\Psi}{dt}",
        "\\mathcal E=-\\frac d{dt}(N\\Phi)=-N\\frac{d\\Phi}{dt}"
      ],
      "spatial": false,
      "start": 30.551999999999996,
      "captions": [
        {
          "start": 30.551999999999996,
          "end": 35.46066666666667,
          "text": "コイルの各一周が囲む面を通る磁束が、どれも同じだとします。"
        },
        {
          "start": 35.61066666666666,
          "end": 41.15933333333333,
          "text": "一巻きごとの起電力を足すと、全体の起電力は一巻きの値の巻数倍です。"
        },
        {
          "start": 41.30933333333333,
          "end": 45.279333333333334,
          "text": "磁束が導線そのものを通る、という意味ではありません。"
        }
      ],
      "end": 46.62933333333333
    }
