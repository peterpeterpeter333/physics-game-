            "電場 [N/C = V/m]。矢印付きはベクトル"
          ],
          [
            "q",
            "運ぶ電荷 [C]。電子では−e"
          ],
          [
            "e",
            "正の電気素量 [C]"
          ],
          [
            "·",
            "対応する成分同士の積を足す内積"
          ],
          [
            "W",
            "電気力がする仕事 [J]"
          ],
          [
            "α",
            "電場の増え方 [V/m²]"
          ],
          [
            "v",
            "積分の中だけで使う目盛り"
          ],
          [
            "eV",
            "エネルギーの単位。1eVは電気素量×1V"
          ]
        ],
        "steps": [
          {
            "note": "現在位置uまでの和。積分の中の目盛りをvと呼び、終点uと区別する。",
            "tex": "W(u)=-e\\alpha\\int_0^u(L^2v+2H^2v^3)dv"
          },
          {
            "note": "微分で確かめる。v²/2はvに、v⁴/4はv³に戻る。",
            "tex": "\\frac d{dv}\\frac{v^2}{2}=v,\\qquad\\frac d{dv}\\frac{v^4}{4}=v^3"
          },
          {
            "note": "項ごとに積分し、2×1/4=1/2を使う。下端0の値は0。",
            "tex": "W(u)=-e\\alpha\\left[\\frac{L^2v^2}{2}+\\frac{H^2v^4}{2}\\right]_0^u=-e\\alpha\\left(\\frac{L^2u^2}{2}+\\frac{H^2u^4}{2}\\right)"
          },
          {
            "note": "図の設定L=H=1m、α=1V/m²、終点u=1。負号は電気力が運ぶ向きに逆らうことを表す。",
            "tex": "W(1)=-e\\cdot1\\,\\mathrm V=-1\\,\\mathrm{eV}"
          }
        ]
      },
