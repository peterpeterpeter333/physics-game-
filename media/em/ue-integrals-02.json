  "scenes": [
    {
      "index": 4,
      "heading": "今回の電場と、電子を運ぶ道を決める",
      "narration": "この例の電場は、原点からの距離に比例して強くなります。電子は、外から操作して指定した放物線に沿って運びます。この道は、電子を自由に放したときの軌道ではありません。",
      "equations": [
        "\\vec E(\\vec r(u))=(\\alpha Lu,\\alpha Hu^2)",
        "\\vec E(x,y)=(\\alpha x,\\alpha y)",
        "x=Lu,\\qquad y=Hu^2"
      ],
      "guide": {
        "kind": "今回の場・代入",
        "read": "E(r(u))は「道の各位置で電場を調べる」という意味。",
        "symbols": [
          [
            "r(u)",
            "目盛りuで指定した位置 [m]"
          ],
          [
            "u",
            "道に付けた無次元の目盛り。時間とは限らない"
          ],
          [
            "L・H",
            "道の横幅・高さ [m]"
          ],
          [
            "r′(u)",
            "uあたりの位置の変化 [m]"
          ],
          [
            "du・dr",
            "微小な目盛りの変化・それに対応する移動"
          ],
          [
            "E",
            "電場 [N/C = V/m]。矢印付きはベクトル"
          ],
          [
            "q",
            "運ぶ電荷 [C]。電子では−e"
          ],
          [
            "e",
            "正の電気素量 [C]"
          ],
          [
            "·",
            "対応する成分同士の積を足す内積"
          ],
          [
            "W",
            "電気力がする仕事 [J]"
          ],
          [
            "α",
            "位置に対する電場の増え方 [V/m²]"
          ]
        ],
        "steps": [
          {
            "note": "計算練習として、この二次元の場を選ぶ。x,yは位置の成分。",
            "tex": "\\vec E(x,y)=(\\alpha x,\\alpha y)"
          },
          {
            "note": "道の式から、横と縦の座標を読む。",
            "tex": "x=Lu,\\qquad y=Hu^2"
          },
          {
            "note": "場のxとyを、その座標で置き換える。",
            "tex": "\\vec E(\\vec r(u))=(\\alpha Lu,\\alpha Hu^2)"
          }
        ]
      },
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.386,
          "text": "この例の電場は、原点からの距離に比例して強くなります。"
        },
        {
          "start": 4.536,
          "end": 9.081999999999999,
          "text": "電子は、外から操作して指定した放物線に沿って運びます。"
        },
        {
          "start": 9.232,
          "end": 13.521999999999998,
          "text": "この道は、電子を自由に放したときの軌道ではありません。"
        }
      ],
      "end": 14.871999999999998
    },
    {
      "index": 5,
      "heading": "道上の電場と移動の内積を取る",
      "narration": "電場と移動の内積では、横成分同士を掛け、縦成分同士を掛けて、その二つを足します。電子に働く電気力の仕事は、この内積に電子の負の電荷を掛けた値です。",
      "equations": [
        "dW=-e\\alpha(L^2u+2H^2u^3)\\,du",
        "dW=-e(\\alpha Lu,\\alpha Hu^2)\\cdot(L,2Hu)\\,du",
        "dW=-e\\left(\\alpha L^2u+2\\alpha H^2u^3\\right)du",
        "dW=-e\\alpha(L^2u+2H^2u^3)du"
      ],
      "guide": {
        "kind": "内積を展開",
        "read": "横同士・縦同士を掛けて足すと、uとu³の積分になる。",
        "symbols": [
          [
            "r(u)",
            "目盛りuで指定した位置 [m]"
          ],
          [
            "u",
            "道に付けた無次元の目盛り。時間とは限らない"
          ],
          [
            "L・H",
            "道の横幅・高さ [m]"
          ],
          [
            "r′(u)",
            "uあたりの位置の変化 [m]"
          ],
          [
            "du・dr",
            "微小な目盛りの変化・それに対応する移動"
          ],
          [
            "E",
            "電場 [N/C = V/m]。矢印付きはベクトル"
          ],
          [
            "q",
            "運ぶ電荷 [C]。電子では−e"
          ],
          [
            "e",
            "正の電気素量 [C]"
          ],
          [
            "·",
            "対応する成分同士の積を足す内積"
          ],
          [
            "W",
            "電気力がする仕事 [J]"
          ],
          [
            "α",
            "電場の増え方 [V/m²]"
          ]
        ],
        "steps": [
          {
            "note": "電子のq=−eと、場・移動の式を代入。",
            "tex": "dW=-e(\\alpha Lu,\\alpha Hu^2)\\cdot(L,2Hu)\\,du"
          },
          {
            "note": "横の積はαL²u、縦の積は2αH²u³。",
            "tex": "dW=-e\\left(\\alpha L^2u+2\\alpha H^2u^3\\right)du"
          },
          {
            "note": "両方の項にあるαを括弧の外へ出す。",
            "tex": "dW=-e\\alpha(L^2u+2H^2u^3)du"
          }
        ]
      },
      "spatial": false,
      "start": 14.871999999999998,
      "captions": [
        {
          "start": 14.871999999999998,
          "end": 21.721999999999998,
          "text": "電場と移動の内積では、横成分同士を掛け、縦成分同士を掛けて、その二つを足します。"
        },
        {
          "start": 21.872,
          "end": 27.506,
          "text": "電子に働く電気力の仕事は、この内積に電子の負の電荷を掛けた値です。"
        }
      ],
      "end": 28.855999999999998
