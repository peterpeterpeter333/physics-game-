  "scenes": [
    {
      "index": 0,
      "heading": "電流の欠片と、観測点への矢印",
      "narration": "ごく短い導線のベクトルは、短く分けた導線の長さと、電流の向きを表します。もう一つの単位ベクトルは、その区間から、磁場を調べる点へ向かう向きです。ビオ・サバールの法則では、この二つから、その区間が作る磁場を求めます。",
      "equations": [
        "d\\vec B=\\frac{\\mu_0I}{4\\pi}\\frac{d\\vec l\\times\\hat r}{r^2}"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.916666666666667,
          "text": "ごく短い導線のベクトルは、短く分けた導線の長さと、電流の向きを表します。"
        },
        {
          "start": 5.916666666666667,
          "end": 10.875,
          "text": "もう一つの単位ベクトルは、その区間から、磁場を調べる点へ向かう向きです。"
        },
        {
          "start": 10.875,
          "end": 16.416666666666664,
          "text": "ビオ・サバールの法則では、この二つから、その区間が作る磁場を求めます。"
        }
      ],
      "end": 16.560999999999993
    },
    {
      "index": 1,
      "heading": "電流はどうやって磁場を作るのだろう? — ビオ・サバール",
      "narration": "時間で変わらない電流が作る磁場は、導線の各区間が作る磁場をベクトルとして足したものです。ビオ・サバールの法則は実験から得た出発点で、数学だけから出てくる結論ではありません。",
      "equations": [
        "dB = \\frac{\\mu_0}{4\\pi}\\frac{Idl\\sin\\theta}{r^2}",
        "B = \\frac{\\mu_0I}{2R}"
      ],
      "spatial": false,
      "start": 16.560999999999993,
      "captions": [
        {
          "start": 16.560999999999993,
          "end": 22.625,
          "text": "時間で変わらない電流が作る磁場は、導線の各区間が作る磁場をベクトルとして足したものです。"
        },
        {
          "start": 22.625,
          "end": 29.041666666666664,
          "text": "ビオ・サバールの法則は実験から得た出発点で、数学だけから出てくる結論ではありません。"
        }
      ],
      "end": 29.170333333333325
    },
    {
      "index": 2,
      "heading": "円形コイル中心の磁場を積分",
      "narration": "円形コイルの各区間から、コイルの中心までの距離は、すべて半径と同じです。各区間が中心に作る磁場の向きも同じです。だから磁場の強さをそのまま足せて、導線の長さの積分は円周になります。",
      "equations": [
        "B=\\frac{\\mu_0I}{4\\pi R^2}\\int dl=\\frac{\\mu_0I}{2R}",
        "dB=\\frac{\\mu_0I}{4\\pi R^2}dl",
        "B=\\frac{\\mu_0I}{4\\pi R^2}\\oint dl",
        "B=\\frac{\\mu_0I}{4\\pi R^2}(2\\pi R)",
        "B=\\frac{\\mu_0I}{2R}"
      ],
      "spatial": false,
      "start": 29.170333333333325,
      "captions": [
        {
          "start": 29.170333333333325,
          "end": 34.70833333333333,
          "text": "円形コイルの各区間から、コイルの中心までの距離は、すべて半径と同じです。"
        },
        {
          "start": 34.70833333333333,
          "end": 37.791666666666664,
          "text": "各区間が中心に作る磁場の向きも同じです。"
        },
        {
          "start": 37.791666666666664,
          "end": 43.24199999999999,
          "text": "だから磁場の強さをそのまま足せて、導線の長さの積分は円周になります。"
        }
      ],
      "end": 44.59199999999999
    }
  ],
