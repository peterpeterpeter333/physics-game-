        "steps": [
          {
            "note": "この場では電気力の仕事を、x方向とy方向に分けて足せる。",
            "tex": "dW=q\\alpha(x\\,dx+y\\,dy)"
          },
          {
            "note": "x dxはx²/2の微分。yも同じなので、どの道でも端点だけが残る。",
