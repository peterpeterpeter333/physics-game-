  "scenes": [
    {
      "index": 0,
      "heading": "コイルはなぜ「電流の慣性」を持つのだろう? — 自己インダクタンス",
      "narration": "ここでは、コイルの電流を二倍にすると、各巻きの磁束も二倍になる場合を考えます。各巻きの磁束を足した値を、鎖交磁束と呼びます。電流が変わると、この磁束も変わり、電流の変化を妨げる起電力が生じます。",
      "equations": [
        "V = -L\\dfrac{dI}{dt}, \\quad U = \\tfrac{1}{2}LI^2",
        "\\Psi=LI",
        "\\mathcal E=-\\frac{d\\Psi}{dt}=-\\frac d{dt}(LI)",
        "\\mathcal E=-L\\frac{dI}{dt}"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 6.231333333333334,
          "text": "ここでは、コイルの電流を二倍にすると、各巻きの磁束も二倍になる場合を考えます。"
        },
        {
          "start": 6.381333333333333,
          "end": 10.276666666666666,
          "text": "各巻きの磁束を足した値を、鎖交磁束と呼びます。"
        },
        {
          "start": 10.426666666666666,
          "end": 16.551333333333332,
          "text": "電流が変わると、この磁束も変わり、電流の変化を妨げる起電力が生じます。"
        }
      ],
      "end": 17.90133333333333
    },
    {
      "index": 1,
      "heading": "自己インダクタンスのLは鎖交磁束の比例",
      "narration": "鎖交磁束を電流で割った比例定数が、自己インダクタンスです。電流が入る端をプラスと決めた端子電圧は、エルかける電流の時間微分です。電流方向を正に測った逆起電力は、そのマイナスなので、二つの式は符号が逆です。",
      "equations": [
        "\\Psi=LI",
        "\\mathcal E=-\\frac{d\\Psi}{dt}=-\\frac d{dt}(LI)",
        "\\mathcal E=-L\\frac{dI}{dt}"
      ],
      "spatial": false,
      "start": 17.90133333333333,
      "captions": [
        {
          "start": 17.90133333333333,
          "end": 22.54333333333333,
          "text": "鎖交磁束を電流で割った比例定数が、自己インダクタンスです。"
        },
        {
          "start": 22.693333333333328,
          "end": 28.433999999999994,
          "text": "電流が入る端をプラスと決めた端子電圧は、エルかける電流の時間微分です。"
        },
        {
          "start": 28.583999999999996,
          "end": 35.12466666666666,
          "text": "電流方向を正に測った逆起電力は、そのマイナスなので、二つの式は符号が逆です。"
        }
      ],
      "end": 36.474666666666664
    },
    {
      "index": 2,
      "heading": "コイルのエネルギーの1/2を積分",
      "narration": "電流を少し増やすとき、現在の電流をアイ、増やす小さな量をディーアイと書きます。コイルに加わるエネルギーは、エルとアイとディーアイの積です。電流ゼロから現在の値まで積分すると、蓄えるエネルギーは二分の一エルアイ二乗です。",
      "equations": [
        "U=\\int_0^I L i\\,di=\\frac12LI^2",
        "P=VI=LI\\frac{dI}{dt}",
        "dU=LI\\,dI",
        "U=\\int_0^I Li\\,di",
        "U=L\\left[\\frac{i^2}{2}\\right]_0^I=\\frac12LI^2"
      ],
      "spatial": false,
      "start": 36.474666666666664,
      "captions": [
        {
          "start": 36.474666666666664,
          "end": 42.33266666666667,
          "text": "電流を少し増やすとき、現在の電流をアイ、増やす小さな量をディーアイと書きます。"
        },
        {
          "start": 42.48266666666667,
          "end": 46.74066666666667,
          "text": "コイルに加わるエネルギーは、エルとアイとディーアイの積です。"
        },
        {
          "start": 46.89066666666667,
          "end": 53.12200000000001,
          "text": "電流ゼロから現在の値まで積分すると、蓄えるエネルギーは二分の一エルアイ二乗です。"
        }
      ],
      "end": 54.472
    }
