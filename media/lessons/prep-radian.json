  "scenes": [
    {
      "narration": "ラジアンは、円の弧の長さを半径で割った角度です。半径二メートルの円で弧が一メートルなら、一割る二で、〇・五ラジアンです。",
      "equation": "角度 θ = 弧の長さ s ÷ 半径 r",
      "diagram": {
        "kind": "bars",
        "labels": [
          "半径",
          "弧の長さ"
        ],
        "values": [
          2,
          1
        ],
        "unit": "m"
      },
      "index": 0,
      "heading": "ラジアンは、円の弧の長さを半径で割った角度です。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 3.7916666666666665,
          "text": "ラジアンは、円の弧の長さを半径で割った角度です。"
        },
        {
          "start": 3.7916666666666665,
          "end": 9.208333333333332,
          "text": "半径二メートルの円で弧が一メートルなら、一割る二で、〇・五ラジアンです。"
        }
      ],
      "end": 9.356999999999998
    },
    {
      "narration": "一周の弧の長さは、半径の二パイ倍です。これを半径で割ると、一周は二パイラジアン。百八十度はその半分で、パイラジアンです。",
      "equation": "360° = 2π rad；180° = π rad",
      "diagram": {
        "kind": "plot",
        "xLabel": "角度 [度]",
        "yLabel": "角度 [rad]",
