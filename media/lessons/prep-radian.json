          ]
        ]
      },
      "index": 1,
      "heading": "一周の弧の長さは、半径の二パイ倍です。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 9.356999999999998,
      "captions": [
        {
          "start": 9.356999999999998,
          "end": 12.624999999999998,
          "text": "一周の弧の長さは、半径の二パイ倍です。"
        },
        {
          "start": 12.624999999999998,
          "end": 15.791666666666664,
          "text": "これを半径で割ると、一周は二パイラジアン。"
        },
        {
          "start": 15.791666666666664,
          "end": 19.20833333333333,
          "text": "百八十度はその半分で、パイラジアンです。"
        }
      ],
      "end": 19.296999999999997
    },
    {
      "narration": "角速度は、角度が一秒あたりにどれだけ増えるかです。一周に四秒かかるなら、角速度は二パイ割る四です。",
      "equation": "角速度 ω = 2π/T；Tは一周の時間",
      "diagram": {
        "kind": "plot",
        "xLabel": "時刻 [s]",
        "yLabel": "角度 [rad]",
        "points": [
          [
            0,
