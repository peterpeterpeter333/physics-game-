  "sourceScript": "uc-shm-advanced-followups-1",
  "scenes": [
    {
      "index": 0,
      "heading": "ここでは、外力と同じ周期で続く振動の振幅を求めます。",
      "narration": "ここでは、外力と同じ周期で続く振動の振幅を求めます。位置の候補は、外力と同じ角振動数のコサインとサインを、それぞれ定数倍して足した関数です。この位置から速度と加速度を計算して、運動方程式に代入します。",
      "visual": "x=C cosΩt+D sinΩtを微分し、cosとsinの列へ整理。",
      "equation": "mx″+bx′+kx = F₀cosΩt",
      "symbols": "mは質量、bは抵抗係数、kはばね定数、F₀は外力振幅、Ωは外力角振動数、C・Dは未知定数。",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.458333333333333,
          "text": "ここでは、外力と同じ周期で続く振動の振幅を求めます。"
        },
        {
          "start": 4.458333333333333,
          "end": 10.916666666666668,
          "text": "位置の候補は、外力と同じ角振動数のコサインとサインを、それぞれ定数倍して足した関数です。"
        },
        {
          "start": 10.916666666666668,
          "end": 15.916666666666668,
          "text": "この位置から速度と加速度を計算して、運動方程式に代入します。"
        }
      ],
      "end": 16.040333333333333
    },
    {
      "index": 1,
      "heading": "すべての時刻で式を一致させるには、コサインとサインの係数をそれぞれ一致させます。",
      "narration": "すべての時刻で式を一致させるには、コサインとサインの係数をそれぞれ一致させます。二つの式を二乗して足すと、交差項が消えます。",
      "visual": "(k−mΩ²)C+bΩD=F₀と(k−mΩ²)D−bΩC=0を作り、二乗の和を展開。",
      "equation": "[(k−mΩ²)²+b²Ω²](C²+D²) = F₀²",
      "symbols": "C²+D²は定常振幅の二乗。",
      "start": 16.040333333333333,
      "captions": [
        {
          "start": 16.040333333333333,
          "end": 21.458333333333336,
          "text": "すべての時刻で式を一致させるには、コサインとサインの係数をそれぞれ一致させます。"
        },
        {
          "start": 21.458333333333336,
          "end": 24.958333333333336,
          "text": "二つの式を二乗して足すと、交差項が消えます。"
        }
      ],
      "end": 25.109333333333332
    },
    {
      "index": 2,
      "heading": "位置の最大振幅は、二つの係数の二乗の和の平方根です。",
      "narration": "位置の最大振幅は、二つの係数の二乗の和の平方根です。私たちは前の動画の振幅式を、候補の代入と係数比較から導けました。",
      "visual": "A=√(C²+D²)を入れ、Aの式を解く。",
      "equation": "A = F₀/√((k−mΩ²)²+b²Ω²)",
      "symbols": "Aは定常振幅。これは解の定常部分であり、初期条件に依存する過渡部分を含まない。",
      "start": 25.109333333333332,
      "captions": [
        {
          "start": 25.109333333333332,
          "end": 29.583333333333332,
          "text": "位置の最大振幅は、二つの係数の二乗の和の平方根です。"
        },
        {
          "start": 29.583333333333332,
          "end": 35.345666666666666,
          "text": "私たちは前の動画の振幅式を、候補の代入と係数比較から導けました。"
        }
      ],
      "end": 36.69566666666667
    }
