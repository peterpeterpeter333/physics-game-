  "scenes": [
    {
      "narration": "斜めの移動は、横の移動と縦の移動に分けられます。横に四、縦に三の直角三角形では、斜めの長さは五です。",
      "equation": "3² + 4² = 5²",
      "diagram": {
        "kind": "vectors",
        "vectors": [
          [
            4,
            3,
            "長さ5"
          ]
        ],
        "components": true
      },
      "index": 0,
      "heading": "斜めの移動は、横の移動と縦の移動に分けられます。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.1193333333333335,
          "text": "斜めの移動は、横の移動と縦の移動に分けられます。"
        },
        {
          "start": 4.269333333333333,
          "end": 9.476666666666667,
          "text": "横に四、縦に三の直角三角形では、斜めの長さは五です。"
        }
      ],
      "end": 10.826666666666664
    },
    {
      "narration": "角度は、横向きから測ります。コサインは「横の辺、割る、斜めの辺」、サインは「縦の辺、割る、斜めの辺」です。",
      "equation": "cos θ = 4/5；sin θ = 3/5",
      "diagram": {
        "kind": "vectors",
        "vectors": [
          [
            4,
            3,
            "θ は横からの角度"
          ]
        ],
        "components": true
      },
      "index": 1,
      "heading": "角度は、横向きから測ります。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 10.826666666666664,
      "captions": [
        {
          "start": 10.826666666666664,
          "end": 13.697999999999997,
          "text": "角度は、横向きから測ります。"
        },
        {
          "start": 13.847999999999997,
          "end": 21.273999999999997,
          "text": "コサインは「横の辺、割る、斜めの辺」、サインは「縦の辺、割る、斜めの辺」です。"
        }
      ],
      "end": 22.623999999999995
    },
    {
      "narration": "斜めの矢印の長さに、この割り算の結果を掛けると、横と縦の分が求まります。同じ角度で長さ十の速度なら、横の速度は八、縦の速度は六です。",
      "equation": "横 = 10 × 4/5 = 8；縦 = 10 × 3/5 = 6",
      "diagram": {
        "kind": "vectors",
        "vectors": [
          [
            8,
            6,
            "速度10 m/s"
          ]
        ],
        "components": true
      },
      "index": 2,
      "heading": "斜めの矢印の長さに、この割り算の結果を掛けると、横と縦の分が求まります。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 22.623999999999995,
      "captions": [
        {
          "start": 22.623999999999995,
          "end": 28.78066666666666,
          "text": "斜めの矢印の長さに、この割り算の結果を掛けると、横と縦の分が求まります。"
        },
        {
          "start": 28.93066666666666,
          "end": 34.73533333333333,
          "text": "同じ角度で長さ十の速度なら、横の速度は八、縦の速度は六です。"
        }
      ],
      "end": 36.08533333333333
    },
    {
      "narration": "投げた物の運動では、横と縦の位置を同じ時刻で計算します。空気抵抗がなければ、重力は縦の速度だけを変え、横の速度は変えません。",
      "equation": "横：速度一定；縦：下向きに加速",
