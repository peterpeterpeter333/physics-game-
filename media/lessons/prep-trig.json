          ]
        ]
      },
      "index": 3,
      "heading": "投げた物の運動では、横と縦の位置を同じ時刻で計算します。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 30.460333333333324,
      "captions": [
        {
          "start": 30.460333333333324,
          "end": 34.99999999999999,
          "text": "投げた物の運動では、横と縦の位置を同じ時刻で計算します。"
        },
        {
          "start": 34.99999999999999,
          "end": 40.676333333333325,
          "text": "空気抵抗がなければ、重力は縦の速度だけを変え、横の速度は変えません。"
