  "scenes": [
    {
      "narration": "横が三、縦が四の矢印では、直角三角形の斜めの辺が矢印の長さです。三平方の定理から、長さは五です。",
      "equation": "|a| = √(3²+4²) = 5",
      "diagram": {
        "kind": "vectors",
        "vectors": [
          [
            3,
            4,
            "a = (3,4)"
          ]
        ],
        "components": true
      },
      "index": 0,
      "heading": "横が三、縦が四の矢印では、直角三角形の斜めの辺が矢印の長さです。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.916666666666667,
          "text": "横が三、縦が四の矢印では、直角三角形の斜めの辺が矢印の長さです。"
        },
        {
          "start": 5.916666666666667,
          "end": 8.958333333333332,
          "text": "三平方の定理から、長さは五です。"
        }
      ],
      "end": 9.091333333333331
    },
    {
      "narration": "奥行きの分もある場合は、平面の中での長さと奥行きで、もう一つ直角三角形を作ります。三つの分の二乗を足して、ルートを取ります。",
      "equation": "|a| = √(aₓ²+aᵧ²+a_z²)",
      "diagram": {
        "kind": "bars",
        "labels": [
          "横²",
          "縦²",
          "奥行き²"
        ],
        "values": [
          9,
          16,
          144
        ],
        "unit": "長さ²"
      },
      "index": 1,
      "heading": "奥行きの分もある場合は、平面の中での長さと奥行きで、もう一つ直角三角形を作ります。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 9.091333333333331,
      "captions": [
        {
          "start": 9.091333333333331,
          "end": 15.541666666666664,
          "text": "奥行きの分もある場合は、平面の中での長さと奥行きで、もう一つ直角三角形を作ります。"
        },
        {
          "start": 15.541666666666664,
          "end": 18.666666666666664,
          "text": "三つの分の二乗を足して、ルートを取ります。"
        }
      ],
      "end": 18.80033333333333
    },
    {
      "narration": "ゼロでない矢印を、その長さで割ると、向きは同じで長さ一の矢印になります。これを単位ベクトルと言います。",
      "equation": "(3,4)/5 = (0.6,0.8)；長さ = 1",
      "diagram": {
        "kind": "vectors",
        "vectors": [
          [
            0.6,
            0.8,
            "長さ1"
          ]
        ],
        "components": true
      },
      "index": 2,
      "heading": "ゼロでない矢印を、その長さで割ると、向きは同じで長さ一の矢印になります。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 18.80033333333333,
      "captions": [
        {
          "start": 18.80033333333333,
          "end": 24.5,
          "text": "ゼロでない矢印を、その長さで割ると、向きは同じで長さ一の矢印になります。"
        },
        {
          "start": 24.5,
          "end": 26.666666666666668,
          "text": "これを単位ベクトルと言います。"
        }
      ],
      "end": 26.802666666666664
    },
    {
      "narration": "面の向きを表すときは、面に垂直な長さ一の矢印を使います。それに面積を掛けると、向きと面積を一本の矢印で表せます。",
      "equation": "面積ベクトル = 面積 × 垂直な単位ベクトル",
      "diagram": {
        "kind": "vectors",
