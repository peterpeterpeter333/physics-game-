      "index": 1,
      "heading": "エルエヌは、底をイーにした対数です。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 9.581999999999997,
      "captions": [
        {
          "start": 9.581999999999997,
          "end": 12.291666666666666,
          "text": "エルエヌは、底をイーにした対数です。"
        },
        {
          "start": 12.291666666666666,
          "end": 19.458333333333332,
          "text": "指数関数と対数は逆の操作なので、「イーのエックス乗」にエルエヌを付けると、エックスに戻ります。"
        }
      ],
      "end": 19.56933333333333
    },
    {
      "narration": "対数の微分は、一割るエックスです。だから、プラスの量エヌで割ってから積分する「変数分離」では、エルエヌが出てきます。",
      "equation": "d(ln N)/dt = (1/N)dN/dt",
      "diagram": {
        "kind": "plot",
        "xLabel": "N（正）",
        "yLabel": "1/N",
        "points": [
          [
