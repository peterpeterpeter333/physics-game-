  "sourceScript": "ui-through-a-surface-bridges-2",
  "scenes": [
    {
      "index": 0,
      "heading": "私たちは、まっすぐな流れの中で平らな枠を傾けます。",
      "narration": "私たちは、まっすぐな流れの中で平らな枠を傾けます。枠の面積が同じでも、流れに正面を向けた広さは変わります。",
      "visual": "3Dの枠と、流れに垂直な面への投影を同時に示す。",
      "equation": "",
      "symbols": "",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.25,
          "text": "私たちは、まっすぐな流れの中で平らな枠を傾けます。"
        },
        {
          "start": 4.25,
          "end": 8.958333333333332,
          "text": "枠の面積が同じでも、流れに正面を向けた広さは変わります。"
        }
      ],
      "end": 9.09033333333333
    },
    {
      "index": 1,
      "heading": "面の法線は、面へ垂直な向きを表す矢印です。",
      "narration": "面の法線は、面へ垂直な向きを表す矢印です。流れと法線が直角になると、流れは面に沿って進み、面を通り抜けません。",
      "visual": "枠・法線・流れを別色にし、90度まで回す。",
      "equation": "",
      "symbols": "",
      "start": 9.09033333333333,
      "captions": [
        {
          "start": 9.09033333333333,
          "end": 13.083333333333332,
          "text": "面の法線は、面へ垂直な向きを表す矢印です。"
        },
        {
          "start": 13.083333333333332,
          "end": 18.791666666666664,
          "text": "流れと法線が直角になると、流れは面に沿って進み、面を通り抜けません。"
        }
      ],
      "end": 18.904999999999994
    },
    {
      "index": 2,
      "heading": "流れに正面を向けた面積を考えると、面の向きの影響を計算できます。",
      "narration": "流れに正面を向けた面積を考えると、面の向きの影響を計算できます。電気束にも同じ計算を使います。ただし、電気束は電場と面の関係を表す量で、電荷そのものが流れる量ではありません。",
      "visual": "流体の図から電場の図へ、共通なのは投影の計算と明記して切り替える。",
      "equation": "",
      "symbols": "",
      "start": 18.904999999999994,
      "captions": [
        {
          "start": 18.904999999999994,
          "end": 24.041666666666664,
          "text": "流れに正面を向けた面積を考えると、面の向きの影響を計算できます。"
        },
        {
          "start": 24.041666666666664,
          "end": 26.541666666666664,
          "text": "電気束にも同じ計算を使います。"
