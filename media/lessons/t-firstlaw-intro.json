  "sourceScript": "t-firstlaw-intro-draft",
  "scenes": [
    {
      "index": 0,
      "heading": "上に動くふた、ピストンの下の気体を温めると、気体は膨らんでピストンを押し上げます。",
      "narration": "上に動くふた、ピストンの下の気体を温めると、気体は膨らんでピストンを押し上げます。受け取ったエネルギーの一部は、この「外へ押す仕事」に使われます。",
      "visual": "熱の流入を内部エネルギー増加とピストンの仕事へ分ける。",
      "equation": "",
      "symbols": "",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.666666666666667,
          "text": "上に動くふた、ピストンの下の気体を温めると、気体は膨らんでピストンを押し上げます。"
        },
        {
          "start": 5.666666666666667,
          "end": 10.833333333333334,
          "text": "受け取ったエネルギーの一部は、この「外へ押す仕事」に使われます。"
        }
      ],
      "end": 10.915333333333331
    },
    {
      "index": 1,
      "heading": "気体の中のエネルギー、内部エネルギーの増え方は、受け取った熱から、外へした仕事を引いたものです。",
      "narration": "気体の中のエネルギー、内部エネルギーの増え方は、受け取った熱から、外へした仕事を引いたものです。仕事をどちら向きをプラスにするか、先に決めておきます。",
      "visual": "100 J流入から30 J仕事を分け、70 Jを容器内に残す。",
      "equation": "ΔU = Q−W",
      "symbols": "ΔUは内部エネルギーの増加、Qは受け取る熱、Wは気体が外へする仕事。単位はすべてJ。",
      "start": 10.915333333333331,
      "captions": [
        {
          "start": 10.915333333333331,
          "end": 17.833333333333336,
          "text": "気体の中のエネルギー、内部エネルギーの増え方は、受け取った熱から、外へした仕事を引いたものです。"
        },
        {
          "start": 17.833333333333336,
          "end": 21.75,
          "text": "仕事をどちら向きをプラスにするか、先に決めておきます。"
        }
      ],
      "end": 21.89366666666666
    },
    {
      "index": 2,
      "heading": "容器が硬くて体積が変わらなければ、膨らむ仕事はゼロです。",
      "narration": "容器が硬くて体積が変わらなければ、膨らむ仕事はゼロです。同じ熱量でも、容器の条件によって温度の上がり方は変わります。",
      "visual": "動くピストンと固定容器を比較。",
      "equation": "",
      "symbols": "",
      "start": 21.89366666666666,
      "captions": [
        {
          "start": 21.89366666666666,
          "end": 26.25,
          "text": "容器が硬くて体積が変わらなければ、膨らむ仕事はゼロです。"
