    {
      "index": 0,
      "heading": "復習：交流は向きと大きさを繰り返し変える",
      "narration": "交流では、電流の向きが周期的に入れ替わります。周期は、電流の変化のパターンが一回繰り返すまでの時間です。振動数は、そのパターンが一秒間に繰り返す回数です。",
      "equations": [
        "f=\\frac1T",
        "\\omega=2\\pi f=\\frac{2\\pi}{T}"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 3.6666666666666665,
          "text": "交流では、電流の向きが周期的に入れ替わります。"
        },
        {
          "start": 3.6666666666666665,
          "end": 8.125,
          "text": "周期は、電流の変化のパターンが一回繰り返すまでの時間です。"
        },
        {
          "start": 8.125,
          "end": 12.333333333333334,
          "text": "振動数は、そのパターンが一秒間に繰り返す回数です。"
        }
      ],
      "end": 12.457333333333331
    },
    {
      "index": 1,
      "heading": "復習：位相は波の進み具合",
      "narration": "同じ周期の電圧と電流でも、最大になる時刻がずれることがあります。このずれを、一周期を一周分の角度として表したものが、位相差です。四分の一周期のずれは、二分のパイラジアンです。",
      "equations": [
        "T\\ \\longleftrightarrow\\ 2\\pi",
        "\\Delta\\phi=2\\pi\\frac{T/4}{T}=\\frac\\pi2"
      ],
      "spatial": false,
      "start": 12.457333333333331,
      "captions": [
        {
          "start": 12.457333333333331,
          "end": 17.375,
          "text": "同じ周期の電圧と電流でも、最大になる時刻がずれることがあります。"
        },
        {
          "start": 17.375,
          "end": 22.208333333333336,
          "text": "このずれを、一周期を一周分の角度として表したものが、位相差です。"
        },
        {
          "start": 22.208333333333336,
          "end": 25.875000000000004,
          "text": "四分の一周期のずれは、二分のパイラジアンです。"
        }
      ],
      "end": 25.991999999999997
    },
    {
      "index": 2,
      "heading": "復習：波は振動の形が空間を伝わる",
      "narration": "波の速さは、「波長割る周期」です。電磁波の図の波形は、物体の位置ではなく、電場や磁場の値を表しています。",
      "equations": [
        "v=\\frac\\lambda T",
        "v=f\\lambda"
      ],
      "spatial": false,
      "start": 25.991999999999997,
      "captions": [
        {
          "start": 25.991999999999997,
          "end": 29.08333333333334,
          "text": "波の速さは、「波長割る周期」です。"
        },
        {
          "start": 29.08333333333334,
          "end": 34.489666666666665,
          "text": "電磁波の図の波形は、物体の位置ではなく、電場や磁場の値を表しています。"
