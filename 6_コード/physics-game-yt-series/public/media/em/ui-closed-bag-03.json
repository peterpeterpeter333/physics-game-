  "scenes": [
    {
      "index": 6,
      "heading": "負の電荷を入れたら、どうなるのだろう?",
      "narration": "内側のマイナスの電荷は、内へ向かう電場を作ります。その電荷による閉曲面の差し引きの電気束は、マイナスになります。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 3.9583333333333335,
          "text": "内側のマイナスの電荷は、内へ向かう電場を作ります。"
        },
        {
          "start": 3.9583333333333335,
          "end": 8.708333333333332,
          "text": "その電荷による閉曲面の差し引きの電気束は、マイナスになります。"
        }
      ],
      "end": 8.835333333333331
    },
    {
      "index": 7,
      "heading": "袋の形を変えると、合計は変わるのだろうか?",
      "narration": "内側の電荷が同じなら、閉曲面の形が変わっても、差し引きの電気束は同じです。面の形を変えることは、各点の電場そのものを変えることではありません。",
      "equations": [],
      "spatial": false,
      "start": 8.835333333333331,
      "captions": [
        {
          "start": 8.835333333333331,
          "end": 14.916666666666664,
          "text": "内側の電荷が同じなら、閉曲面の形が変わっても、差し引きの電気束は同じです。"
        },
        {
          "start": 14.916666666666664,
          "end": 19.874999999999996,
          "text": "面の形を変えることは、各点の電場そのものを変えることではありません。"
        }
      ],
      "end": 20.024999999999995
    },
    {
      "index": 8,
      "heading": "閉じた面の合計は、何を教えてくれるのだろう?",
      "narration": "ガウスの法則によると、閉曲面全体の電気束は、内側の電荷の合計に比例します。内側の合計の電荷が二倍なら、電気束も二倍です。ただし、各点の電場を求めるには、電荷の配置や対称性も調べる必要があります。",
      "equations": [],
      "spatial": false,
      "start": 20.024999999999995,
      "captions": [
        {
          "start": 20.024999999999995,
          "end": 26.249999999999996,
          "text": "ガウスの法則によると、閉曲面全体の電気束は、内側の電荷の合計に比例します。"
        },
        {
          "start": 26.249999999999996,
          "end": 30.16666666666666,
          "text": "内側の合計の電荷が二倍なら、電気束も二倍です。"
        },
        {
          "start": 30.16666666666666,
          "end": 36.347333333333324,
          "text": "ただし、各点の電場を求めるには、電荷の配置や対称性も調べる必要があります。"
        }
      ],
      "end": 37.69733333333332
    }
  ],
