  "scenes": [
    {
      "index": 4,
      "heading": "なぜ送電線は数十万ボルトなのだろう?",
      "narration": "送る電力が同じなら、送電の電圧を高くするほど、必要な電流は小さくて済みます。送電線の発熱は電流の二乗に比例するので、電流が小さいほど損失が減ります。",
      "equations": [
        "P_{\\rm 送}=V_{\\rm 送}I,\\qquad P_{\\rm 損}=I^2R_{\\rm 線}"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 6.125,
          "text": "送る電力が同じなら、送電の電圧を高くするほど、必要な電流は小さくて済みます。"
        },
        {
          "start": 6.125,
          "end": 12.041666666666668,
          "text": "送電線の発熱は電流の二乗に比例するので、電流が小さいほど損失が減ります。"
        }
      ],
      "end": 12.152666666666665
    },
    {
      "index": 5,
      "heading": "送電の電圧と線の電圧降下は別",
      "narration": "送電の電圧と、送電線そのものの両端の電圧の下がりは、別のものです。発熱を「電圧の二乗割る抵抗」で計算するなら、その電圧には送電線での電圧の下がりを使います。「電流の二乗かける抵抗」で計算しても、同じ発熱になります。",
      "equations": [
        "I=\\frac{P_{\\rm 送}}{V_{\\rm 送}}",
        "P_{\\rm 損}=R_{\\rm 線}\\left(\\frac{P_{\\rm 送}}{V_{\\rm 送}}\\right)^2",
        "P'_{\\rm 損}=R_{\\rm 線}\\left(\\frac{P_{\\rm 送}}{10V_{\\rm 送}}\\right)^2",
        "P'_{\\rm 損}=\\frac1{100}P_{\\rm 損}"
      ],
      "spatial": false,
      "start": 12.152666666666665,
      "captions": [
        {
          "start": 12.152666666666665,
          "end": 17.625,
          "text": "送電の電圧と、送電線そのものの両端の電圧の下がりは、別のものです。"
        },
        {
          "start": 17.625,
          "end": 24.958333333333332,
          "text": "発熱を「電圧の二乗割る抵抗」で計算するなら、その電圧には送電線での電圧の下がりを使います。"
        },
        {
          "start": 24.958333333333332,
          "end": 29.999333333333333,
          "text": "「電流の二乗かける抵抗」で計算しても、同じ発熱になります。"
        }
      ],
      "end": 31.349333333333334
    }
  ],
