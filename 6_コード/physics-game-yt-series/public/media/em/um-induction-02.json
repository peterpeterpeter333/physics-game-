  "scenes": [
    {
      "index": 3,
      "heading": "発電機は、なぜ交流を出すのだろう?",
      "narration": "回転するコイルでは、面の法線と磁場の間の角度が、時間とともに変わります。磁束は、その角度のコサインに比例します。磁束を時間で微分すると、サインの形で変わる起電力が求まります。",
      "equations": [
        "\\Phi=BA\\cos(\\omega t)",
        "\\mathcal E=-N\\frac d{dt}[BA\\cos(\\omega t)]",
        "\\mathcal E=-NBA\\frac d{dt}\\cos(\\omega t)",
        "\\mathcal E=-NBA[-\\sin(\\omega t)]\\omega",
        "\\mathcal E=NBA\\omega\\sin(\\omega t)"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.583333333333333,
          "text": "回転するコイルでは、面の法線と磁場の間の角度が、時間とともに変わります。"
        },
        {
          "start": 5.583333333333333,
          "end": 8.75,
          "text": "磁束は、その角度のコサインに比例します。"
        },
        {
          "start": 8.75,
          "end": 13.708333333333334,
          "text": "磁束を時間で微分すると、サインの形で変わる起電力が求まります。"
        }
      ],
      "end": 13.798333333333334
    },
    {
      "index": 4,
      "heading": "回転するコイルを微分する途中",
      "narration": "回転するコイルの磁束を微分すると、コサインの微分のマイナスと、角速度の係数が出てきます。ファラデーの法則のマイナスと微分のマイナスが打ち消し合って、起電力の式になります。",
      "equations": [
        "\\mathcal E=-N\\frac{d}{dt}(BA\\cos\\omega t)=NBA\\omega\\sin\\omega t",
        "\\Phi=BA\\cos(\\omega t)",
        "\\mathcal E=-N\\frac d{dt}[BA\\cos(\\omega t)]",
        "\\mathcal E=-NBA\\frac d{dt}\\cos(\\omega t)",
        "\\mathcal E=-NBA[-\\sin(\\omega t)]\\omega",
        "\\mathcal E=NBA\\omega\\sin(\\omega t)"
      ],
      "spatial": false,
      "start": 13.798333333333334,
      "captions": [
        {
          "start": 13.798333333333334,
          "end": 20.16666666666667,
          "text": "回転するコイルの磁束を微分すると、コサインの微分のマイナスと、角速度の係数が出てきます。"
        },
        {
          "start": 20.16666666666667,
          "end": 25.625,
          "text": "ファラデーの法則のマイナスと微分のマイナスが打ち消し合って、起電力の式になります。"
        }
      ],
      "end": 25.76866666666666
    },
    {
      "index": 5,
      "heading": "一定の磁場でも動く導線は起電力を生む",
      "narration": "動く棒が作る回路の面積が変わる速さは、「棒の長さかける速さ」です。磁場が一定でも、この面積の変化が磁束を変え、起電力を生みます。",
      "equations": [
        "A=lx",
        "\\Phi=Blx",
        "\\frac{d\\Phi}{dt}=Bl\\frac{dx}{dt}=Blv",
        "|\\mathcal E|=Blv"
      ],
      "spatial": false,
      "start": 25.76866666666666,
      "captions": [
        {
          "start": 25.76866666666666,
          "end": 31.125,
          "text": "動く棒が作る回路の面積が変わる速さは、「棒の長さかける速さ」です。"
        },
        {
          "start": 31.125,
          "end": 36.37833333333334,
          "text": "磁場が一定でも、この面積の変化が磁束を変え、起電力を生みます。"
        }
      ],
      "end": 37.72833333333333
    }
  ],
