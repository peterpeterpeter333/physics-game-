{
  "id": "ue-ampere-02",
  "stageId": "ue-ampere",
  "stageTitle": "アンペールの法則",
  "level": "advanced",
  "title": "長いソレノイドの四辺を数えて磁場を導く",
  "sourceIndices": [
    3,
