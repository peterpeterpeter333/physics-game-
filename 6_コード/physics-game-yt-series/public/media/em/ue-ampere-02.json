  ],
  "scenes": [
    {
      "index": 3,
      "heading": "ソレノイドの中は、なぜ一様な磁場なのだろう?",
      "narration": "十分に長いソレノイド、つまり筒状に巻いたコイルの中央付近では、内側の磁場はほぼ一定で、外の磁場は小さくなります。内側と外側をまたぐ長方形の道を選んで、アンペールの法則を使います。どの辺で磁場と進む向きが重なるかを、次に調べます。",
      "equations": [
        "B = \\mu_0 n I",
        "\\oint\\vec B\\cdot d\\vec r=BL+0+0+0",
        "BL=\\mu_0(nL)I",
        "B=\\mu_0nI",
        "B=\\mu_0\\frac Nl I"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 8.375,
          "text": "十分に長いソレノイド、つまり筒状に巻いたコイルの中央付近では、内側の磁場はほぼ一定で、外の磁場は小さくなります。"
        },
        {
          "start": 8.375,
          "end": 13.666666666666668,
          "text": "内側と外側をまたぐ長方形の道を選んで、アンペールの法則を使います。"
        },
        {
          "start": 13.666666666666668,
          "end": 17.75,
          "text": "どの辺で磁場と進む向きが重なるかを、次に調べます。"
        }
      ],
      "end": 17.842
    },
    {
      "index": 4,
      "heading": "ソレノイドの長方形の4辺を数える",
      "narration": "この近似では、長方形のうち、コイルの内側にある辺だけが一周の積分に残ります。長方形が囲む面を、「一メートルあたりの巻数かける辺の長さ」本の導線が横切ります。この本数に一巻きの電流を掛けると、面を貫く電流の合計です。",
      "equations": [
        "\\oint\\vec B\\cdot d\\vec r=BL+0+0+0",
        "BL=\\mu_0(nL)I",
        "B=\\mu_0nI",
        "B=\\mu_0\\frac Nl I"
      ],
      "spatial": false,
      "start": 17.842,
      "captions": [
        {
          "start": 17.842,
          "end": 23.875,
          "text": "この近似では、長方形のうち、コイルの内側にある辺だけが一周の積分に残ります。"
        },
        {
          "start": 23.875,
          "end": 30.125,
          "text": "長方形が囲む面を、「一メートルあたりの巻数かける辺の長さ」本の導線が横切ります。"
        },
        {
          "start": 30.125,
          "end": 35.125,
          "text": "この本数に一巻きの電流を掛けると、面を貫く電流の合計です。"
        }
      ],
      "end": 35.27966666666667
    },
    {
      "index": 5,
      "heading": "長さLが消えて巻数密度だけ残る",
      "narration": "アンペールの法則の式の左右に、長方形の辺の長さが出てくるので、消せます。残るのは、「透磁率かける、一メートルあたりの巻数かける電流」です。短いコイルや端の近くでは磁場が一様でなくなり、この近似式からずれます。",
      "equations": [
        "B=\\mu_0\\frac{N}{l}I",
        "\\oint\\vec B\\cdot d\\vec r=BL+0+0+0",
        "BL=\\mu_0(nL)I",
        "B=\\mu_0nI",
        "B=\\mu_0\\frac Nl I"
      ],
      "spatial": false,
      "start": 35.27966666666667,
      "captions": [
        {
          "start": 35.27966666666667,
          "end": 40.875,
          "text": "アンペールの法則の式の左右に、長方形の辺の長さが出てくるので、消せます。"
        },
        {
          "start": 40.875,
          "end": 45.875,
          "text": "残るのは、「透磁率かける、一メートルあたりの巻数かける電流」です。"
        },
        {
          "start": 45.875,
          "end": 51.32366666666667,
          "text": "短いコイルや端の近くでは磁場が一様でなくなり、この近似式からずれます。"
        }
      ],
      "end": 52.67366666666667
    }
  ],
