  "scenes": [
    {
      "index": 4,
      "heading": "磁場が弱いタイルは、どう数えるのだろう?",
      "narration": "三枚目と四枚目の面では、面に垂直な磁場の分が、最初の二枚より小さくなっています。ここで比べるのは、磁場全体の強さではなく、その面に垂直な分です。各面の磁束は、「この分かける面積」です。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 6.25,
          "text": "三枚目と四枚目の面では、面に垂直な磁場の分が、最初の二枚より小さくなっています。"
        },
        {
          "start": 6.25,
          "end": 11.208333333333332,
          "text": "ここで比べるのは、磁場全体の強さではなく、その面に垂直な分です。"
        },
        {
          "start": 11.208333333333332,
          "end": 15.333333333333332,
          "text": "各面の磁束は、「この分かける面積」です。"
        }
      ],
      "end": 15.422666666666665
    },
    {
      "index": 5,
      "heading": "タイル3の寄与は、いくつになるだろう?",
      "narration": "三枚目の法線方向の磁場は一テスラです。三枚目の磁束は、一かける〇点五で〇点五ウェーバです。",
      "equations": [
        "\\Delta\\Phi_3=1\\times0.5",
        "\\Delta\\Phi_3=0.5\\,\\mathrm{Wb}"
      ],
      "spatial": false,
      "start": 15.422666666666665,
      "captions": [
        {
          "start": 15.422666666666665,
          "end": 18.541666666666668,
          "text": "三枚目の法線方向の磁場は一テスラです。"
        },
        {
          "start": 18.541666666666668,
          "end": 22.75,
          "text": "三枚目の磁束は、一かける〇点五で〇点五ウェーバです。"
        }
      ],
      "end": 22.881999999999994
    },
    {
      "index": 6,
      "heading": "タイル4の寄与は、いくつになるだろう?",
      "narration": "四枚目では、磁場は面と平行です。法線方向の分がゼロなので、四枚目の磁束もゼロです。",
      "equations": [
        "\\Delta\\Phi_4=0\\times0.5",
        "\\Delta\\Phi_4=0\\,\\mathrm{Wb}"
      ],
      "spatial": false,
      "start": 22.881999999999994,
      "captions": [
        {
          "start": 22.881999999999994,
          "end": 25.791666666666664,
          "text": "四枚目では、磁場は面と平行です。"
        },
        {
          "start": 25.791666666666664,
          "end": 29.958333333333332,
          "text": "法線方向の分がゼロなので、四枚目の磁束もゼロです。"
        }
      ],
      "end": 30.096999999999998
    },
    {
      "index": 7,
      "heading": "4枚を合計すると、磁束はいくらになるだろう?",
      "narration": "面全体の磁束は、四枚の磁束の合計です。一足す一足す〇点五足すゼロで、二点五ウェーバです。",
      "equations": [
        "\\Phi=1+1+0.5+0=2.5\\,\\mathrm{Wb}",
        "\\Phi=\\Delta\\Phi_1+\\Delta\\Phi_2+\\Delta\\Phi_3+\\Delta\\Phi_4",
        "\\Phi=1+1+0.5+0",
        "\\Phi=2.5\\,\\mathrm{Wb}"
      ],
      "spatial": false,
      "start": 30.096999999999998,
      "captions": [
        {
          "start": 30.096999999999998,
          "end": 33.70833333333333,
          "text": "面全体の磁束は、四枚の磁束の合計です。"
        },
        {
          "start": 33.70833333333333,
          "end": 37.688,
          "text": "一足す一足す〇点五足すゼロで、二点五ウェーバです。"
        }
