  "scenes": [
    {
      "index": 6,
      "heading": "これで、ガウスの法則を証明したことになるだろうか?",
      "narration": "ここまでの計算は、電気束の面積分を、簡単な掛け算に直した段階です。電荷との関係や、一般の面での証明は、まだこの計算だけでは示せません。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.583333333333333,
          "text": "ここまでの計算は、電気束の面積分を、簡単な掛け算に直した段階です。"
        },
        {
          "start": 5.583333333333333,
          "end": 11.333333333333332,
          "text": "電荷との関係や、一般の面での証明は、まだこの計算だけでは示せません。"
        }
      ],
      "end": 11.488333333333333
    },
    {
      "index": 7,
      "heading": "対称性は、法則が成り立つための条件なのだろうか?",
      "narration": "ガウスの法則は、球以外の閉曲面でも成り立ちます。ここでは、点電荷が面そのものの上に乗る場合は除きます。対称性は法則の条件ではなく、面の上でどこも同じ電場の強さを積分の外へ出して計算するための、手掛かりです。",
      "equations": [],
      "spatial": false,
      "start": 11.488333333333333,
      "captions": [
        {
          "start": 11.488333333333333,
          "end": 15.416666666666664,
          "text": "ガウスの法則は、球以外の閉曲面でも成り立ちます。"
        },
        {
          "start": 15.416666666666664,
          "end": 19.374999999999996,
          "text": "ここでは、点電荷が面そのものの上に乗る場合は除きます。"
        },
        {
          "start": 19.374999999999996,
          "end": 27.541666666666664,
          "text": "対称性は法則の条件ではなく、面の上でどこも同じ電場の強さを積分の外へ出して計算するための、手掛かりです。"
        }
      ],
      "end": 27.61699999999999
    },
    {
      "index": 8,
      "heading": "この一手が使えないのは、どんな場合だろう?",
      "narration": "中心が電荷からずれた球では、電場の大きさと、法線との角度が場所によって違います。その場合の面積分は、同じ電場をくくり出す掛け算にはなりません。",
      "equations": [],
      "spatial": false,
      "start": 27.61699999999999,
      "captions": [
        {
          "start": 27.61699999999999,
          "end": 33.75,
          "text": "中心が電荷からずれた球では、電場の大きさと、法線との角度が場所によって違います。"
        },
        {
          "start": 33.75,
          "end": 38.5,
          "text": "その場合の面積分は、同じ電場をくくり出す掛け算にはなりません。"
        }
      ],
      "end": 38.58566666666666
    },
    {
      "index": 9,
      "heading": "中心球の電気束は、クーロンの法則からいくらになる？",
      "narration": "点電荷の電場の式には、半径の二乗が分母にあります。球の表面積の式には、同じ半径の二乗が分子にあります。電場と面積を掛けると、この二つが打ち消し合って、電気束は「電荷割る真空の誘電率」になります。",
      "equations": [
        "\\Phi_E=\\frac{Q}{\\varepsilon_0}",
        "E=\\frac{Q}{4\\pi\\varepsilon_0r^2}\\quad(Q>0)",
        "\\Phi_E=\\frac{Q}{4\\pi\\varepsilon_0r^2}\\,4\\pi r^2"
      ],
      "spatial": false,
      "start": 38.58566666666666,
      "captions": [
        {
          "start": 38.58566666666666,
          "end": 42.583333333333336,
          "text": "点電荷の電場の式には、半径の二乗が分母にあります。"
        },
        {
          "start": 42.583333333333336,
          "end": 47.041666666666664,
          "text": "球の表面積の式には、同じ半径の二乗が分子にあります。"
        },
        {
          "start": 47.041666666666664,
          "end": 54.67233333333333,
          "text": "電場と面積を掛けると、この二つが打ち消し合って、電気束は「電荷割る真空の誘電率」になります。"
        }
      ],
      "end": 56.02233333333333
    }
