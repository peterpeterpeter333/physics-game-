  "scenes": [
    {
      "index": 0,
      "heading": "指数関数の解を電荷へ戻す",
      "narration": "充電が終わったときの電荷から今の電荷を引いたものを、残りの差と呼びます。この差は、「アールかけるシー」を時定数として、指数関数の形で減ります。今の電荷は「最終の電荷引く差」で、充電電流は、その電荷が増える速さです。",
      "equations": [
        "I=\\frac{dq}{dt}=\\frac{V_0}{R}e^{-t/(RC)}",
        "\\frac{u'}u=-\\frac1{RC}",
        "\\ln|u|=-\\frac t{RC}+K",
        "u=CV_0e^{-t/(RC)}",
        "q=CV_0-u=CV_0(1-e^{-t/(RC)})",
        "I=q'=CV_0\\frac1{RC}e^{-t/(RC)}=\\frac{V_0}{R}e^{-t/(RC)}"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.833333333333333,
          "text": "充電が終わったときの電荷から今の電荷を引いたものを、残りの差と呼びます。"
        },
        {
          "start": 4.833333333333333,
          "end": 10.125,
          "text": "この差は、「アールかけるシー」を時定数として、指数関数の形で減ります。"
        },
        {
          "start": 10.125,
          "end": 16.375,
          "text": "今の電荷は「最終の電荷引く差」で、充電電流は、その電荷が増える速さです。"
        }
      ],
      "end": 16.477666666666664
    },
    {
      "index": 1,
      "heading": "コイルの回路では、何が「なまる」のだろう?",
      "narration": "コイルの逆起電力は、電流の急な変化を邪魔します。抵抗とコイルを一列につないだ回路では、電池をつないでも電流はゼロから少しずつ増えます。「エル割るアール」秒後には、電流は最終値の約六十三パーセントです。",
      "equations": [
        "\\tau = \\dfrac{L}{R}",
        "I(t) = \\frac{V_0}{R}(1 - e^{-t/\\tau})",
        "\\tau = \\frac{L}{R}"
      ],
      "spatial": false,
      "start": 16.477666666666664,
      "captions": [
        {
          "start": 16.477666666666664,
          "end": 20.416666666666668,
          "text": "コイルの逆起電力は、電流の急な変化を邪魔します。"
        },
        {
          "start": 20.416666666666668,
          "end": 26.208333333333336,
          "text": "抵抗とコイルを一列につないだ回路では、電池をつないでも電流はゼロから少しずつ増えます。"
        },
        {
          "start": 26.208333333333336,
          "end": 31.375000000000004,
          "text": "「エル割るアール」秒後には、電流は最終値の約六十三パーセントです。"
        }
      ],
      "end": 31.494000000000003
    },
    {
      "index": 2,
      "heading": "RL回路の式も差を使って解く",
      "narration": "「最終の電流引く今の電流」の残りの差は、指数関数の形で減ります。最初の電流がゼロなら、最初の差は最終の電流そのものです。この最初の条件を使って、答えに含まれる定数を決めます。",
      "equations": [
        "V_0=RI+LI'",
        "I'=\\frac RL\\left(\\frac{V_0}R-I\\right)",
        "u'=-\\frac RLu",
        "u=\\frac{V_0}R e^{-Rt/L}",
        "I=\\frac{V_0}R(1-e^{-Rt/L})"
      ],
      "spatial": false,
      "start": 31.494000000000003,
      "captions": [
        {
          "start": 31.494000000000003,
          "end": 36.95833333333334,
          "text": "「最終の電流引く今の電流」の残りの差は、指数関数の形で減ります。"
        },
        {
          "start": 36.95833333333334,
          "end": 41.33333333333334,
          "text": "最初の電流がゼロなら、最初の差は最終の電流そのものです。"
        },
        {
          "start": 41.33333333333334,
          "end": 45.83233333333334,
          "text": "この最初の条件を使って、答えに含まれる定数を決めます。"
        }
      ],
      "end": 47.18233333333333
    }
