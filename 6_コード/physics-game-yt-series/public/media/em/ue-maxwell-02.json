  "scenes": [
    {
      "index": 2,
      "heading": "真空の平面波を1方向へ絞る",
      "narration": "この平面波、つまり平らな波面で進む波は、エックス方向へ進み、電場はワイ方向、磁場はゼット方向です。ファラデーの法則と、変位電流を含むアンペールの法則を使います。この二つで、場の「場所による変化」と「時間による変化」を結びます。",
      "equations": [
        "\\frac{\\partial E_y}{\\partial x}=-\\frac{\\partial B_z}{\\partial t}",
        "-\\frac{\\partial B_z}{\\partial x}=\\mu_0\\varepsilon_0\\frac{\\partial E_y}{\\partial t}"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 8.0,
          "text": "この平面波、つまり平らな波面で進む波は、エックス方向へ進み、電場はワイ方向、磁場はゼット方向です。"
        },
        {
          "start": 8.0,
          "end": 12.291666666666666,
          "text": "ファラデーの法則と、変位電流を含むアンペールの法則を使います。"
        },
        {
          "start": 12.291666666666666,
          "end": 18.083333333333336,
          "text": "この二つで、場の「場所による変化」と「時間による変化」を結びます。"
        }
      ],
      "end": 18.18633333333333
    },
    {
      "index": 3,
      "heading": "周回積分が、場の差になる理由",
      "narration": "小さな長方形の左右の辺では、電場のワイ成分に辺の長さを掛けて足します。二つの辺を回る向きが逆なので、二点の電場の差が残ります。この結果を面積で割り、幅をゼロに近づけると、電場のワイ成分が位置エックスでどう変わるかを表せます。",
      "equations": [
        "\\oint\\vec E\\cdot d\\vec r=[E_y(x+dx)-E_y(x)]dy",
        "[E_y(x+dx)-E_y(x)]dy=-\\frac{\\partial B_z}{\\partial t}dx\\,dy",
        "\\frac{E_y(x+dx)-E_y(x)}{dx}=-\\frac{\\partial B_z}{\\partial t}",
        "\\frac{\\partial E_y}{\\partial x}=-\\frac{\\partial B_z}{\\partial t}"
      ],
      "spatial": false,
      "start": 18.18633333333333,
      "captions": [
        {
          "start": 18.18633333333333,
          "end": 23.583333333333336,
          "text": "小さな長方形の左右の辺では、電場のワイ成分に辺の長さを掛けて足します。"
        },
        {
          "start": 23.583333333333336,
          "end": 28.0,
          "text": "二つの辺を回る向きが逆なので、二点の電場の差が残ります。"
        },
        {
          "start": 28.0,
          "end": 35.00000000000001,
          "text": "この結果を面積で割り、幅をゼロに近づけると、電場のワイ成分が位置エックスでどう変わるかを表せます。"
        }
      ],
      "end": 35.11300000000001
    },
