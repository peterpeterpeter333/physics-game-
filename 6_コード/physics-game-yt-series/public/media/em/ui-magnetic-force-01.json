  "scenes": [
    {
      "index": 0,
      "heading": "復習：力は速さだけでなく向きも変える",
      "narration": "速度は、速さだけでなく向きも持つ量です。進む向きに直角な力は、速さを変えなくても、速度の向きを変えられます。",
      "equations": [
        "\\vec a=\\frac{\\Delta\\vec v}{\\Delta t}",
        "\\vec F=m\\vec a"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 3.2083333333333335,
          "text": "速度は、速さだけでなく向きも持つ量です。"
        },
        {
          "start": 3.2083333333333335,
          "end": 8.625,
          "text": "進む向きに直角な力は、速さを変えなくても、速度の向きを変えられます。"
        }
      ],
      "end": 8.791666666666668
    },
    {
      "index": 1,
      "heading": "復習：磁場・速度・磁気力の向きを分ける",
      "narration": "磁気力の矢印は、粒子の速度の矢印にも、磁場の矢印にも直角です。同じ磁場の中で、同じ速度のプラスの電荷とマイナスの電荷を比べると、磁気力は逆向きになります。",
      "equations": [],
      "spatial": false,
      "start": 8.791666666666668,
      "captions": [
        {
          "start": 8.791666666666668,
          "end": 14.458333333333332,
          "text": "磁気力の矢印は、粒子の速度の矢印にも、磁場の矢印にも直角です。"
        },
        {
          "start": 14.458333333333332,
          "end": 21.541666666666664,
          "text": "同じ磁場の中で、同じ速度のプラスの電荷とマイナスの電荷を比べると、磁気力は逆向きになります。"
        }
      ],
      "end": 21.710333333333327
    },
    {
      "index": 2,
      "heading": "復習：直角な力は仕事をしない",
      "narration": "磁気力は、粒子がその瞬間に進む向きと直角なので、仕事はゼロです。だから磁気力だけなら、運動エネルギーは変わりません。粒子の速さは変わらず、進む向きだけが変わります。",
      "equations": [
        "dW=F\\,ds\\cos90^\\circ=0",
        "dK=dW=0"
      ],
      "spatial": false,
      "start": 21.710333333333327,
      "captions": [
        {
          "start": 21.710333333333327,
          "end": 27.041666666666664,
          "text": "磁気力は、粒子がその瞬間に進む向きと直角なので、仕事はゼロです。"
        },
        {
          "start": 27.041666666666664,
          "end": 30.749999999999996,
          "text": "だから磁気力だけなら、運動エネルギーは変わりません。"
        },
        {
          "start": 30.749999999999996,
          "end": 34.60766666666667,
          "text": "粒子の速さは変わらず、進む向きだけが変わります。"
