  "scenes": [
    {
      "index": 7,
      "heading": "力のうち、実際に効くのはどの部分だろう?",
      "narration": "仕事の計算では、力のうち、進む向きを向いた分を使います。力と移動の矢印の間の角度をシータとすると、この分は「力の大きさかけるコサインシータ」です。",
      "equations": [
        "F_{\\parallel}=|\\vec F|\\cos\\theta_i"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.791666666666667,
          "text": "仕事の計算では、力のうち、進む向きを向いた分を使います。"
        },
        {
          "start": 4.791666666666667,
          "end": 11.916666666666668,
          "text": "力と移動の矢印の間の角度をシータとすると、この分は「力の大きさかけるコサインシータ」です。"
        }
      ],
      "end": 12.065333333333331
    },
    {
      "index": 8,
      "heading": "小区間の仕事は、何と何の掛け算になるだろう?",
      "narration": "一区間の仕事の近似値は、「進む向きの力の分かける、短い移動の長さ」です。区間の中で力が一定で、移動がまっすぐなら、この掛け算は正確です。",
      "equations": [
        "\\Delta W_i=\\left(|\\vec F|\\cos\\theta_i\\right)|\\Delta\\vec r_i|"
      ],
      "spatial": false,
      "start": 12.065333333333331,
      "captions": [
        {
          "start": 12.065333333333331,
          "end": 18.458333333333336,
          "text": "一区間の仕事の近似値は、「進む向きの力の分かける、短い移動の長さ」です。"
        },
        {
          "start": 18.458333333333336,
          "end": 23.833333333333336,
          "text": "区間の中で力が一定で、移動がまっすぐなら、この掛け算は正確です。"
        }
      ],
      "end": 23.91933333333333
    },
    {
      "index": 9,
      "heading": "この形に、名前を付けてよいのだろうか?",
      "narration": "二つのベクトルの内積とは、「大きさどうしかける、角度のコサイン」です。内積の記号には、二つの矢印の向きの関係も含まれています。",
      "equations": [
        "\\vec F\\cdot\\Delta\\vec r=|\\vec F|\\,|\\Delta\\vec r|\\cos\\theta"
      ],
      "spatial": false,
      "start": 23.91933333333333,
      "captions": [
        {
          "start": 23.91933333333333,
          "end": 29.125000000000004,
          "text": "二つのベクトルの内積とは、「大きさどうしかける、角度のコサイン」です。"
        },
        {
          "start": 29.125000000000004,
          "end": 33.79166666666667,
          "text": "内積の記号には、二つの矢印の向きの関係も含まれています。"
        }
      ],
      "end": 33.92700000000001
    },
    {
      "index": 10,
      "heading": "小区間の仕事は、結局どう書けるのだろう?",
      "narration": "一定の力によるまっすぐな移動の仕事は、力と移動の内積です。成分で計算するなら、「横どうしの積、足す、縦どうしの積」です。",
      "equations": [
        "\\Delta W_i=\\vec F(\\vec r_i)\\cdot\\Delta\\vec r_i"
      ],
      "spatial": false,
      "start": 33.92700000000001,
      "captions": [
        {
          "start": 33.92700000000001,
          "end": 38.750000000000014,
          "text": "一定の力によるまっすぐな移動の仕事は、力と移動の内積です。"
        },
        {
          "start": 38.750000000000014,
          "end": 44.44166666666666,
          "text": "成分で計算するなら、「横どうしの積、足す、縦どうしの積」です。"
        }
      ],
      "end": 45.79166666666667
    }
