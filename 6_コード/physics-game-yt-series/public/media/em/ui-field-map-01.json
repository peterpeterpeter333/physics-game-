  "scenes": [
    {
      "index": 0,
      "heading": "場所ごとに矢印が決まっているとは、どういうことだろう?",
      "narration": "電場の図では、ある場所を選ぶと、その場所の電場を一本の矢印で表せます。矢印の向きが電場の向き、矢印の長さが電場の強さです。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.541666666666667,
          "text": "電場の図では、ある場所を選ぶと、その場所の電場を一本の矢印で表せます。"
        },
        {
          "start": 5.541666666666667,
          "end": 10.041666666666668,
          "text": "矢印の向きが電場の向き、矢印の長さが電場の強さです。"
        }
      ],
      "end": 10.187999999999999
    },
    {
      "index": 1,
      "heading": "矢印の長さは、何の大きさを表すのだろう?",
      "narration": "矢印の長さは、その場所の電場の強さです。単位のニュートン毎クーロンは、「一クーロンあたりに受ける力」という意味です。",
      "equations": [],
      "spatial": false,
      "start": 10.187999999999999,
      "captions": [
        {
          "start": 10.187999999999999,
          "end": 13.625000000000002,
          "text": "矢印の長さは、その場所の電場の強さです。"
        },
        {
          "start": 13.625000000000002,
          "end": 18.666666666666664,
          "text": "単位のニュートン毎クーロンは、「一クーロンあたりに受ける力」という意味です。"
        }
      ],
      "end": 18.808999999999997
    },
    {
      "index": 2,
      "heading": "置く電荷を変えたら、地図も描き直すのだろうか?",
      "narration": "同じ場所に置く電荷の量を変えると、その電荷が受ける力は変わります。ここでは、電場を作っている電荷の配置は変えません。力を調べるために置く電荷だけを変えても、元の電場は同じです。",
      "equations": [],
      "spatial": false,
      "start": 18.808999999999997,
      "captions": [
        {
          "start": 18.808999999999997,
          "end": 23.583333333333336,
          "text": "同じ場所に置く電荷の量を変えると、その電荷が受ける力は変わります。"
        },
        {
          "start": 23.583333333333336,
          "end": 27.041666666666664,
          "text": "ここでは、電場を作っている電荷の配置は変えません。"
        },
        {
          "start": 27.041666666666664,
          "end": 31.792666666666662,
          "text": "力を調べるために置く電荷だけを変えても、元の電場は同じです。"
        }
      ],
      "end": 33.14266666666666
    }
  ],
