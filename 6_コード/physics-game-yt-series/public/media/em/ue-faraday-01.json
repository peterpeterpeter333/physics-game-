  ],
  "scenes": [
    {
      "index": 0,
      "heading": "コイルはなぜ「電流の慣性」を持つのだろう? — 自己インダクタンス",
      "narration": "ここでは、コイルの電流を二倍にすると、各巻きの磁束も二倍になる場合を考えます。各巻きの磁束を足したものを、鎖交磁束と呼びます。電流が変わるとこの磁束も変わり、電流の変化を邪魔する向きの起電力が生じます。",
      "equations": [
        "V = -L\\dfrac{dI}{dt}, \\quad U = \\tfrac{1}{2}LI^2",
        "\\Psi=LI",
        "\\mathcal E=-\\frac{d\\Psi}{dt}=-\\frac d{dt}(LI)",
        "\\mathcal E=-L\\frac{dI}{dt}"
      ],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.916666666666667,
          "text": "ここでは、コイルの電流を二倍にすると、各巻きの磁束も二倍になる場合を考えます。"
        },
        {
          "start": 5.916666666666667,
          "end": 9.5,
          "text": "各巻きの磁束を足したものを、鎖交磁束と呼びます。"
        },
        {
          "start": 9.5,
          "end": 15.291666666666668,
          "text": "電流が変わるとこの磁束も変わり、電流の変化を邪魔する向きの起電力が生じます。"
        }
      ],
      "end": 15.399333333333335
    },
    {
      "index": 1,
      "heading": "自己インダクタンスのLは鎖交磁束の比例",
      "narration": "「鎖交磁束割る電流」の比例定数が、自己インダクタンス、エルです。電流が入る端をプラスと決めた端子の電圧は、「エルかける、電流の時間微分」です。電流の向きをプラスとして測った逆起電力はそのマイナスなので、二つの式は符号が逆です。",
      "equations": [
        "\\Psi=LI",
        "\\mathcal E=-\\frac{d\\Psi}{dt}=-\\frac d{dt}(LI)",
        "\\mathcal E=-L\\frac{dI}{dt}"
      ],
      "spatial": false,
      "start": 15.399333333333335,
      "captions": [
        {
          "start": 15.399333333333335,
          "end": 20.375000000000004,
          "text": "「鎖交磁束割る電流」の比例定数が、自己インダクタンス、エルです。"
        },
        {
          "start": 20.375000000000004,
          "end": 26.500000000000004,
          "text": "電流が入る端をプラスと決めた端子の電圧は、「エルかける、電流の時間微分」です。"
        },
        {
          "start": 26.500000000000004,
          "end": 32.708333333333336,
          "text": "電流の向きをプラスとして測った逆起電力はそのマイナスなので、二つの式は符号が逆です。"
        }
      ],
      "end": 32.867000000000004
    },
    {
      "index": 2,
      "heading": "コイルのエネルギーの1/2を積分",
      "narration": "電流を少し増やすとき、今の電流をアイ、増やす小さな量をディーアイと書きます。コイルに加わるエネルギーは、「エルかけるアイかけるディーアイ」です。電流ゼロから今の値まで積分すると、蓄えるエネルギーは「二分の一エルアイ二乗」です。",
      "equations": [
        "U=\\int_0^I L i\\,di=\\frac12LI^2",
        "P=VI=LI\\frac{dI}{dt}",
        "dU=LI\\,dI",
        "U=\\int_0^I Li\\,di",
        "U=L\\left[\\frac{i^2}{2}\\right]_0^I=\\frac12LI^2"
      ],
      "spatial": false,
      "start": 32.867000000000004,
      "captions": [
        {
          "start": 32.867000000000004,
          "end": 38.208333333333336,
          "text": "電流を少し増やすとき、今の電流をアイ、増やす小さな量をディーアイと書きます。"
        },
        {
          "start": 38.208333333333336,
          "end": 42.458333333333336,
          "text": "コイルに加わるエネルギーは、「エルかけるアイかけるディーアイ」です。"
        },
        {
          "start": 42.458333333333336,
          "end": 49.264,
          "text": "電流ゼロから今の値まで積分すると、蓄えるエネルギーは「二分の一エルアイ二乗」です。"
        }
      ],
      "end": 50.614
    }
  ],
