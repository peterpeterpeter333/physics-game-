{
  "id": "ue-faraday-01",
  "stageId": "ue-faraday",
  "stageTitle": "ファラデーの法則を微分で",
  "level": "advanced",
  "title": "自己誘導の式からコイルのエネルギーを求める",
  "sourceIndices": [
