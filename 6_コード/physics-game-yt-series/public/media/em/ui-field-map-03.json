  "scenes": [
    {
      "index": 6,
      "heading": "磁場の地図は、電場の地図と何が違うのだろう?",
      "narration": "磁場も、各場所での向きと強さを矢印で表せます。磁力線は、その矢印の向きに沿って描いた線です。磁力線は本当にあるひもではなく、磁場の向きを見やすくするための線です。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 3.9166666666666665,
          "text": "磁場も、各場所での向きと強さを矢印で表せます。"
        },
        {
          "start": 3.9166666666666665,
          "end": 7.666666666666666,
          "text": "磁力線は、その矢印の向きに沿って描いた線です。"
        },
        {
          "start": 7.666666666666666,
          "end": 12.666666666666666,
          "text": "磁力線は本当にあるひもではなく、磁場の向きを見やすくするための線です。"
        }
      ],
      "end": 12.826666666666664
    },
    {
      "index": 7,
      "heading": "地図の上に道や面を置くと、何が読めるのだろう?",
      "narration": "電気力の仕事を求めるときは、「進む方向の電場の分」に、電荷と移動距離を掛けます。電気束を求めるときは、「面に垂直な電場の分」に、面積を掛けます。掛ける相手も、求めるものも違います。",
      "equations": [],
      "spatial": false,
      "start": 12.826666666666664,
      "captions": [
        {
          "start": 12.826666666666664,
          "end": 19.374999999999996,
          "text": "電気力の仕事を求めるときは、「進む方向の電場の分」に、電荷と移動距離を掛けます。"
        },
        {
          "start": 19.374999999999996,
          "end": 24.95833333333333,
          "text": "電気束を求めるときは、「面に垂直な電場の分」に、面積を掛けます。"
        },
        {
          "start": 24.95833333333333,
          "end": 27.999999999999996,
          "text": "掛ける相手も、求めるものも違います。"
        }
      ],
      "end": 28.11066666666666
    },
    {
      "index": 8,
      "heading": "矢印の地図から、これから何を取り出すのだろう?",
      "narration": "道全体の仕事は、各区間で電気力がした仕事を足して求めます。面全体の電気束は、各区画を通る電気束を足して求めます。「区間ごとに足す」考え方が線積分に、「区画ごとに足す」考え方が面積分につながります。",
      "equations": [],
      "spatial": false,
      "start": 28.11066666666666,
      "captions": [
        {
          "start": 28.11066666666666,
          "end": 32.83333333333333,
          "text": "道全体の仕事は、各区間で電気力がした仕事を足して求めます。"
        },
        {
          "start": 32.83333333333333,
          "end": 37.33333333333333,
          "text": "面全体の電気束は、各区画を通る電気束を足して求めます。"
        },
        {
          "start": 37.33333333333333,
          "end": 44.187666666666665,
          "text": "「区間ごとに足す」考え方が線積分に、「区画ごとに足す」考え方が面積分につながります。"
        }
      ],
      "end": 45.53766666666667
    }
  ],
