  "scenes": [
    {
      "index": 0,
      "heading": "場とは、位置ごとに矢印が1本決まる地図だろうか?",
      "narration": "位置ベクトルは、空間のどの点を調べるかを指定します。電場ベクトルは、その指定した点での、電場の強さと向きを表します。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 3.75,
          "text": "位置ベクトルは、空間のどの点を調べるかを指定します。"
        },
        {
          "start": 3.75,
          "end": 8.791666666666668,
          "text": "電場ベクトルは、その指定した点での、電場の強さと向きを表します。"
        }
      ],
      "end": 8.919666666666664
    },
    {
      "index": 1,
      "heading": "矢印は、どうすれば計算に持ち込めるだろう?",
      "narration": "電場の矢印は、横の分と縦の分の組で表せます。各成分の大きさは、その方向の電場の強さで、プラスマイナスが向きを表します。",
      "equations": [
        "\\vec E=(E_x,\\;E_y)",
        "\\vec E=(4,3)\\,\\mathrm{N/C}"
      ],
      "spatial": false,
      "start": 8.919666666666664,
      "captions": [
        {
          "start": 8.919666666666664,
          "end": 13.0,
          "text": "電場の矢印は、横の分と縦の分の組で表せます。"
        },
        {
          "start": 13.0,
          "end": 18.833333333333336,
          "text": "各成分の大きさは、その方向の電場の強さで、プラスマイナスが向きを表します。"
        }
      ],
      "end": 18.97
    },
    {
      "index": 2,
      "heading": "一様な電場での仕事は、どんな式だったろう?",
      "narration": "一様な電場と同じ向きにまっすぐ動くとき、仕事は「電荷かける電場かける距離」です。一クーロンの電荷が三ニュートン毎クーロンの場を一メートル進む仕事は、三ジュールです。",
      "equations": [
        "W=qE\\Delta x"
      ],
      "spatial": false,
      "start": 18.97,
      "captions": [
        {
          "start": 18.97,
          "end": 25.16666666666667,
          "text": "一様な電場と同じ向きにまっすぐ動くとき、仕事は「電荷かける電場かける距離」です。"
        },
        {
          "start": 25.16666666666667,
          "end": 30.750000000000004,
          "text": "一クーロンの電荷が三ニュートン毎クーロンの場を一メートル進む仕事は、三ジュールです。"
        }
      ],
      "end": 30.855
    },
    {
      "index": 3,
      "heading": "道が曲がると、どの距離を使えばよいのだろう?",
      "narration": "曲がった道では、電荷の進む向きが区間ごとに違います。一つの距離と電場の大きさだけでは、その道の仕事は計算できません。",
      "equations": [],
      "spatial": false,
      "start": 30.855,
      "captions": [
        {
          "start": 30.855,
          "end": 34.833333333333336,
          "text": "曲がった道では、電荷の進む向きが区間ごとに違います。"
        },
        {
          "start": 34.833333333333336,
          "end": 39.70566666666667,
          "text": "一つの距離と電場の大きさだけでは、その道の仕事は計算できません。"
        }
      ],
      "end": 41.055666666666674
    }
  ],
