  "scenes": [
    {
      "index": 0,
      "heading": "平らな面では、4枚の寄与はどうなるだろう?",
      "narration": "平面の四つの区画が同じ磁場と面積なら、四つの磁束は同じです。各区画の〇点一ウェーバを足すと、〇点四ウェーバです。",
      "equations": [],
      "spatial": false,
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.833333333333333,
          "text": "平面の四つの区画が同じ磁場と面積なら、四つの磁束は同じです。"
        },
        {
          "start": 4.833333333333333,
          "end": 8.833333333333332,
          "text": "各区画の〇点一ウェーバを足すと、〇点四ウェーバです。"
        }
      ],
      "end": 8.941999999999997
    },
    {
      "index": 1,
      "heading": "曲がった面では、1枚ずつどう変わるのだろう?",
      "narration": "曲がった面では、各区画の磁場と法線の角度が違います。各区画の分は、プラスだけでなく、ゼロやマイナスにもなります。",
      "equations": [],
      "spatial": false,
      "start": 8.941999999999997,
      "captions": [
        {
          "start": 8.941999999999997,
          "end": 13.166666666666666,
          "text": "曲がった面では、各区画の磁場と法線の角度が違います。"
        },
        {
          "start": 13.166666666666666,
          "end": 17.625,
          "text": "各区画の分は、プラスだけでなく、ゼロやマイナスにもなります。"
        }
      ],
      "end": 17.756
    },
    {
      "index": 2,
      "heading": "面全体の磁束は、どう足し上げるのだろう?",
      "narration": "面全体の磁束の近似値は、各区画で「磁場の法線方向の分かける面積」を求め、それを足したものです。シグマは、区画そのものではなく、各区画で求めた磁束を足す記号です。",
      "equations": [
        "\\Phi_N=\\sum_{i=1}^{N}\\vec B(\\vec r_i)\\cdot\\vec n_i\\,\\Delta A_i"
      ],
      "spatial": false,
      "start": 17.756,
      "captions": [
        {
          "start": 17.756,
          "end": 26.041666666666668,
          "text": "面全体の磁束の近似値は、各区画で「磁場の法線方向の分かける面積」を求め、それを足したものです。"
        },
        {
          "start": 26.041666666666668,
          "end": 31.46966666666667,
          "text": "シグマは、区画そのものではなく、各区画で求めた磁束を足す記号です。"
        }
      ],
      "end": 32.81966666666667
    }
  ],
