          ],
          [
            3,
            7
          ]
        ]
      },
      "index": 0,
      "heading": "このグラフは、横が時刻、縦が位置です。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 3.2916666666666665,
          "text": "このグラフは、横が時刻、縦が位置です。"
        },
        {
          "start": 3.2916666666666665,
          "end": 5.833333333333333,
          "text": "点の高さが物体の位置を表します。"
        },
        {
          "start": 5.833333333333333,
          "end": 10.291666666666666,
          "text": "線の形は、物体が実際に通った道の形ではありません。"
        }
      ],
      "end": 10.441333333333333
    },
    {
      "narration": "時刻が一秒進む間に、位置は二メートル増えています。グラフの傾きは、縦の変化を横の変化で割って求めます。ここでは二割る一で、二です。",
      "equation": "傾き = (7 − 1) m ÷ (3 − 0) s = 2 m/s",
      "diagram": {
        "kind": "plot",
        "xLabel": "時刻 [s]",
        "yLabel": "位置 [m]",
        "points": [
          [
            0,
