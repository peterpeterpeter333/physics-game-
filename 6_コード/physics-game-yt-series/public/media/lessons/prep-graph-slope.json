          ]
        ],
        "slope": true
      },
      "index": 1,
      "heading": "時刻が一秒進む間に、位置は二メートル増えています。",
      "symbols": "",
      "visual": "Explicit diagram configuration",
      "start": 10.441333333333333,
      "captions": [
        {
          "start": 10.441333333333333,
          "end": 14.291666666666668,
          "text": "時刻が一秒進む間に、位置は二メートル増えています。"
        },
        {
          "start": 14.291666666666668,
          "end": 18.416666666666668,
          "text": "グラフの傾きは、縦の変化を横の変化で割って求めます。"
        },
        {
          "start": 18.416666666666668,
          "end": 20.958333333333332,
          "text": "ここでは二割る一で、二です。"
        }
      ],
      "end": 21.09499999999999
    },
    {
      "narration": "位置のグラフが水平なら、時間がたっても位置は変わりません。物体は止まっていて、速度はゼロです。",
      "equation": "位置の変化 = 0 → 速度 = 0",
      "diagram": {
        "kind": "plot",
