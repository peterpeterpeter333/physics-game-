  "scenes": [
    {
      "narration": "このグラフは、横が時刻、縦が位置です。点の高さが物体の位置を表します。線の形は、物体が実際に通った道の形ではありません。",
      "equation": "横軸：時刻；縦軸：位置",
      "diagram": {
        "kind": "plot",
        "xLabel": "時刻 [s]",
        "yLabel": "位置 [m]",
        "points": [
          [
            0,
            1
          ],
