  "scenes": [
    {
      "index": 0,
      "heading": "投げた物の運動では、横の加速度はゼロ、縦の加速度は下向きの重力加速度です。",
      "narration": "投げた物の運動では、横の加速度はゼロ、縦の加速度は下向きの重力加速度です。同じ時刻を使って、横と縦の二つの成分を積分します。",
      "visual": "xとyの二本の運動方程式を同じ時計の下へ並べる。",
      "equation": "x=x₀+v₀x t；y=y₀+v₀y t−gt²/2",
      "symbols": "x・yは位置、添字0は初期値、gは重力加速度の大きさ。",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 6.083333333333333,
          "text": "投げた物の運動では、横の加速度はゼロ、縦の加速度は下向きの重力加速度です。"
        },
        {
          "start": 6.083333333333333,
          "end": 10.541666666666666,
          "text": "同じ時刻を使って、横と縦の二つの成分を積分します。"
        }
      ],
      "end": 10.669999999999998
    },
    {
      "index": 1,
      "heading": "求めた位置を二回微分すると、横はゼロ、縦はマイナス重力加速度に戻ります。",
      "narration": "求めた位置を二回微分すると、横はゼロ、縦はマイナス重力加速度に戻ります。時刻ゼロを入れると、最初の位置と初速度も一致します。",
      "visual": "微分の検算と初期条件の検算を別々に点灯する。",
      "equation": "",
      "symbols": "",
      "start": 10.669999999999998,
      "captions": [
        {
          "start": 10.669999999999998,
          "end": 16.541666666666664,
          "text": "求めた位置を二回微分すると、横はゼロ、縦はマイナス重力加速度に戻ります。"
        },
        {
          "start": 16.541666666666664,
          "end": 20.583333333333332,
          "text": "時刻ゼロを入れると、最初の位置と初速度も一致します。"
        }
      ],
      "end": 20.677666666666664
    },
    {
      "index": 2,
      "heading": "力が速度で変わる場合は、この等加速度の答えは使えません。",
