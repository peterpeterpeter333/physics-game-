  "scenes": [
    {
      "index": 0,
      "heading": "力が位置に比例する区間を、同じ幅の小区間へ分けます。",
      "narration": "力が位置に比例する区間を、同じ幅の小区間へ分けます。私たちは各区間の右端の力に幅を掛け、仕事を近似します。",
      "visual": "0〜LをN等分し、F=kxの右端を採用。",
      "equation": "W_N = Σ[i=1…N] k(iL/N)(L/N)",
      "symbols": "kは力の増加率[N/m]、Lは全移動距離、Nは区間数、iは区間番号。",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 4.083333333333333,
          "text": "力が位置に比例する区間を、同じ幅の小区間へ分けます。"
        },
        {
          "start": 4.083333333333333,
          "end": 8.958333333333332,
          "text": "私たちは各区間の右端の力に幅を掛け、仕事を近似します。"
        }
      ],
      "end": 9.059333333333331
    },
    {
      "index": 1,
      "heading": "整数の和を計算すると、仕事の和は二分の一かける比例係数かける距離の二乗へ近づきます。",
      "narration": "整数の和を計算すると、仕事の和は二分の一かける比例係数かける距離の二乗へ近づきます。分割数に由来する余分な項はゼロへ近づきます。",
      "visual": "Σi=N(N+1)/2を代入し、1/Nの項を消す極限を示す。",
      "equation": "lim[N→∞] W_N = kL²/2",
      "symbols": "W_Nは有限分割の近似、極限が正確な仕事。",
      "start": 9.059333333333331,
      "captions": [
        {
          "start": 9.059333333333331,
          "end": 15.458333333333332,
          "text": "整数の和を計算すると、仕事の和は二分の一かける比例係数かける距離の二乗へ近づきます。"
        },
        {
          "start": 15.458333333333332,
          "end": 18.999999999999996,
          "text": "分割数に由来する余分な項はゼロへ近づきます。"
        }
      ],
      "end": 19.08933333333333
    },
    {
      "index": 2,
      "heading": "仕事の和の極限は、力と位置のグラフにできる三角形の面積とも一致します。",
      "narration": "仕事の和の極限は、力と位置のグラフにできる三角形の面積とも一致します。私たちは図の面積と、積分の計算が同じ足し算を表すことを確認できます。",
      "visual": "三角形の面積とΣの極限を同じ結果へつなぐ。",
      "equation": "",
