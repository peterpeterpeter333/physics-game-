  "scenes": [
    {
      "index": 0,
      "heading": "車輪の各点の速度は、重心の移動と、重心まわりの回転を足したものです。",
      "narration": "車輪の各点の速度は、重心の移動と、重心まわりの回転を足したものです。滑らずに転がると、地面に触れている点では、この二つが打ち消し合います。",
      "visual": "車輪の下端へ右向きv重心と左向きRωを描く。",
      "equation": "",
      "symbols": "",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 5.583333333333333,
          "text": "車輪の各点の速度は、重心の移動と、重心まわりの回転を足したものです。"
        },
        {
          "start": 5.583333333333333,
          "end": 10.75,
          "text": "滑らずに転がると、地面に触れている点では、この二つが打ち消し合います。"
        }
      ],
      "end": 10.883333333333333
    },
    {
      "index": 1,
      "heading": "地面に触れている点は、その瞬間は地面に対して止まっています。",
      "narration": "地面に触れている点は、その瞬間は地面に対して止まっています。ただし次の瞬間には、別の点が地面に触れます。",
      "visual": "接地点の点に色を付け、車輪を少し進めて次の点へ切り替える。",
      "equation": "",
      "symbols": "",
      "start": 10.883333333333333,
      "captions": [
        {
          "start": 10.883333333333333,
          "end": 15.208333333333334,
          "text": "地面に触れている点は、その瞬間は地面に対して止まっています。"
        },
        {
          "start": 15.208333333333334,
          "end": 18.958333333333336,
          "text": "ただし次の瞬間には、別の点が地面に触れます。"
        }
