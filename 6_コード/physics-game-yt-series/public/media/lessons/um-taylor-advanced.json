  "sourceScript": "um-taylor-advanced-draft",
  "scenes": [
    {
      "index": 0,
      "heading": "二次式で関数を近似するには、基準の点で、値と一階微分と二階微分をそろえます。",
      "narration": "二次式で関数を近似するには、基準の点で、値と一階微分と二階微分をそろえます。二次の項を二回微分すると、係数に二が掛かります。",
      "visual": "c₂h²→2c₂h→2c₂の微分を順に表示。",
      "equation": "",
      "symbols": "",
      "start": 0,
      "captions": [
        {
          "start": 0,
          "end": 6.083333333333333,
          "text": "二次式で関数を近似するには、基準の点で、値と一階微分と二階微分をそろえます。"
        },
        {
          "start": 6.083333333333333,
          "end": 9.958333333333332,
          "text": "二次の項を二回微分すると、係数に二が掛かります。"
        }
      ],
      "end": 10.093
    },
    {
      "index": 1,
      "heading": "二階微分を元の関数と一致させるために、二次の係数を二階微分の半分にします。",
      "narration": "二階微分を元の関数と一致させるために、二次の係数を二階微分の半分にします。同じ考え方で、もっと高い次数では階乗が分母に出てきます。",
      "visual": "2c₂=f″(a)からc₂=f″(a)/2を導く。",
      "equation": "f(a+h) ≈ f(a)+f′(a)h+f″(a)h²/2",
      "symbols": "f″は二階微分。hは基準点からの差。使う次数より先の項が誤差になる。",
      "start": 10.093,
      "captions": [
        {
          "start": 10.093,
          "end": 15.791666666666668,
          "text": "二階微分を元の関数と一致させるために、二次の係数を二階微分の半分にします。"
        },
        {
          "start": 15.791666666666668,
          "end": 20.291666666666668,
          "text": "同じ考え方で、もっと高い次数では階乗が分母に出てきます。"
        }
      ],
      "end": 20.420666666666666
    },
    {
      "index": 2,
      "heading": "位置エネルギーが谷底になる点では、傾きはゼロです。",
      "narration": "位置エネルギーが谷底になる点では、傾きはゼロです。さらに二階微分がプラスなら、近くの形は二次式で近似でき、ばねと同じ運動につながります。二階微分もゼロになる谷底には、この近似をそのまま使えません。",
      "visual": "エネルギー曲線の谷を二次式へ重ね、力の直線へ接続。",
      "equation": "",
      "symbols": "",
      "start": 20.420666666666666,
      "captions": [
        {
          "start": 20.420666666666666,
          "end": 24.375,
          "text": "位置エネルギーが谷底になる点では、傾きはゼロです。"
        },
        {
          "start": 24.375,
          "end": 30.875000000000004,
          "text": "さらに二階微分がプラスなら、近くの形は二次式で近似でき、ばねと同じ運動につながります。"
        },
        {
          "start": 30.875000000000004,
          "end": 35.56966666666667,
          "text": "二階微分もゼロになる谷底には、この近似をそのまま使えません。"
        }
      ],
      "end": 36.91966666666667
    }
